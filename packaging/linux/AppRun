#!/bin/sh
# The AppImage's entry point. The AppImage is read-only and has no game data, so the game
# reads its files from a data folder: $BEVY_ASSET_ROOT if set, else the folder holding the
# .AppImage when it has an assets/ folder (the tarball's layout), else
# ${XDG_DATA_HOME:-~/.local/share}/stealth-mission-89. The shipped assets (shaders) are copied into it on
# every start, so they match this build.
HERE="$(dirname "$(readlink -f "$0")")"
if [ -z "$BEVY_ASSET_ROOT" ]; then
    beside="$(dirname "${APPIMAGE:-$HERE}")"
    if [ -d "$beside/assets" ]; then
        BEVY_ASSET_ROOT="$beside"
    else
        BEVY_ASSET_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/stealth-mission-89"
    fi
    mkdir -p "$BEVY_ASSET_ROOT/assets" && cp -rf "$HERE/usr/share/stealth-mission-89/assets/." "$BEVY_ASSET_ROOT/assets/"
    export BEVY_ASSET_ROOT
fi
# X11 windows need libxkbcommon-x11 (winit panics without it), which minimal systems lack: then
# the bundled copy (with its libxcb-xkb).
if ! { ldconfig -p 2>/dev/null || /sbin/ldconfig -p 2>/dev/null; } | grep -q 'libxkbcommon-x11\.so\.0 '; then
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$HERE/usr/lib/fallback"
fi
# The Steam Frame (SteamOS on aarch64) starts in VR: Steam launches apps there in a 2D window
# otherwise. It takes `--gl-vr` (glvr's renderer, with eye-tracked foveation); `--vr` picks
# Bevy's renderer instead, `--desktop` keeps the window.
case " $* " in
    *" --vr "*) ;;
    *" --gl-vr "*) ;;
    *" --desktop "*) ;;
    *)
        if [ "$(uname -m)" = aarch64 ] && grep -qs '^ID=steamos$' /etc/os-release; then
            set -- --gl-vr "$@"
        fi
        ;;
esac
# Started from a launcher (Steam, a file manager, the Steam Frame), not a terminal: the game sends
# its standard output and error to its log file (~/.local/state/stealth-mission-89).
if [ ! -t 2 ]; then
    export SM89_LOG_STDERR=1
fi
exec "$HERE/usr/bin/stealth-mission-89" "$@"
