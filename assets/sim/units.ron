    chaff: 30,
    decoys: 2,
    gun_rounds: 510,
    // Which way each classic theater's take-off runway points: true from the south end north.
    runway_north: {"libya": false, "persian_gulf": true, "north_cape": false, "central_europe": true, "vietnam": false,
                   "middle_east": true, "desert_storm": true, "cuba": false, "korea": true},
)
