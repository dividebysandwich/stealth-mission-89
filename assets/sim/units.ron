#![enable(implicit_some)]
// The simulation's units: radars, aircraft, missiles and the player's stores.
//
// Each list's order is its index (theater files name SAM sites' radars and flights' aircraft
// by it), so new entries go at the end. Values are real-world figures; crates/stealth-sim/src/
// data.rs turns them into the simulation's game-scaled numbers:
// - radar detection = 60 + 0.7 x search range (km), tier = (year in service - 1945) / 6.5,
//   both clamped (to 50..500 and 2..8);
// - aircraft speed = 280 + 200 x Mach (helicopters 0.68, drones 0.6 x km/h), range = 0.75 x
//   combat radius (drones: one-way range);
// - missile reach = 2.75 x range (km) for SAMs (up to 150), 4 + 0.45 x range for air-to-air
//   missiles, 4 + 0.35 x range for air-to-ground ones; speed = 400 + 450 x Mach (up to 2000);
//   turn = 1.2 x the square root of the g limit (1..8).
(
    radars: [
        (id: "none", name: "None", search_km: 0, year: 1945),
        (id: "sa2", name: "SA-2", search_km: 275, year: 1957, missile: "sa2"),
        (id: "sa5", name: "SA-5", search_km: 400, year: 1966, missile: "sa5"),
        (id: "sa8", name: "SA-8B", search_km: 30, year: 1971, missile: "sa8"),
        (id: "sa10", name: "SA-10", search_km: 300, year: 1978, doppler: true, missile: "sa10"),
        (id: "sa11", name: "SA-11", search_km: 160, year: 1979, doppler: true, missile: "sa11"),
