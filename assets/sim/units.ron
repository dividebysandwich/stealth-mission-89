        (id: "awacs", name: "A-50", search_km: 230, year: 1984, doppler: true, airborne: true),
        // Fighter radars.
        (id: "rp21", name: "RP-21", search_km: 25, year: 1960),
        (id: "sapfir23", name: "Sapfir-23", search_km: 55, year: 1970),
        (id: "n019", name: "N019", search_km: 70, year: 1982, doppler: true),
        (id: "zaslon", name: "Zaslon", search_km: 200, year: 1981, doppler: true),
        (id: "oth", name: "OTH", search_km: 1000, year: 1976, doppler: true),
        (id: "spin_scan", name: "Spin Scan", search_km: 20, year: 1955),
        (id: "sa21", name: "SA-21", search_km: 600, year: 2007, doppler: true, missile: "sa21"),
        (id: "sa17", name: "SA-17", search_km: 160, year: 2008, doppler: true, missile: "sa17"),
