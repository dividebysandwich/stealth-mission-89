# Ο οδηγός πλήκτρων (src/key_guide.rs). Στα πλήκτρα, το "_" αντικαθιστά το κενό.

kg-vr-controllers = ΧΕΙΡΙΣΤΗΡΙΑ VR
kg-vr-grip = GRIP
    .desc = Πιάστε το stick, τη μανέτα ισχύος ή το kneeboard
kg-vr-fingertip = ΑΚΡΗ_ΔΑΧΤΥΛΟΥ
    .desc = Πατήστε διακόπτες και κουμπιά, καρτέλες του kneeboard
kg-vr-left-stick = ΑΡΙΣΤΕΡΟ_STICK
    .desc = Μετακίνηση του κέρσορα του αισθητήρα
kg-vr-stick = STICK
    .desc = Κύλιση αυτής της λίστας (δάχτυλο στο kneeboard)
kg-gun-target = Πυροβόλο
kg-mouse = ΠΟΝΤΙΚΙ
kg-mouse-right-drag = ΔΕΞΙ_ΣΥΡΣΙΜΟ
    .desc = Ματιά γύρω (έξω: περιστροφή της κάμερας)
kg-mouse-hold-right = ΔΕΞΙ_ΠΑΤΗΜΕΝΟ, ΡΟΔΕΛΑ
    .desc = Μεγέθυνση / σμίκρυνση της εικόνας
kg-mouse-left-click = ΑΡΙΣΤΕΡΟ_ΚΛΙΚ
    .desc = Πάτημα διακόπτη ή κουμπιού του πιλοτηρίου, καρτέλας του kneeboard
kg-mouse-point = ΕΠΙΣΗΜΑΝΣΗ
    .desc = Tooltip ενός χειριστηρίου του πιλοτηρίου (μενού: TOOLTIPS)
kg-mouse-wheel = ΡΟΔΕΛΑ
    .desc = Κύλιση αυτής της λίστας
kg-unbound = ΧΩΡΙΣ_ΠΛΗΚΤΡΟ

