# Τα tooltips του πιλοτηρίου (src/cockpit3d/tooltips.rs). Ένας τίτλος που είναι ένδειξη του
# πιλοτηρίου (λυχνία, κουμπί, αρκτικόλεξο) μένει στα αγγλικά· οι περιγραφές μεταφράζονται.

## Ενδείξεις οργάνων

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (από 0 έως 99)
tip-wings-level = φτερά οριζόντια
tip-bank-right = κλίση { $deg }° δεξιά
tip-bank-left = κλίση { $deg }° αριστερά
tip-attitude-readout = Πρόνευση { $pitch }°, { $bank }
tip-heading = Πορεία { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° σε { $distance }
tip-nozzle-open = ανοιχτό κατά { $value } %
tip-nozzles = Ακροφύσια { $deg }°
tip-key = Πλήκτρο: { $key }
tip-keys = Πλήκτρα: { $keys }

## Ενέργειες: το όνομα, μετά τι κάνουν

tip-gear = Σύστημα προσγείωσης
    .desc = Μαζεμένο / κατεβασμένο (ο μοχλός δείχνει τη θέση)
tip-autopilot = Αυτόματος πιλότος
    .desc = Πετά προς το τρέχον waypoint (Tornado: ακολουθώντας το έδαφος)
tip-bay-doors = Θύρες θαλάμου οπλισμού
    .desc = Άνοιγμα / κλείσιμο· τα όπλα ρίχνονται μόνο με ανοιχτούς θαλάμους
tip-flaps = Flaps
    .desc = Περισσότερη άνωση, ταχύτητα απώλειας στήριξης περίπου 20 % χαμηλότερη
tip-brakes = Φρένα
    .desc = Φρένα τροχών στο έδαφος, αεροφρένο στον αέρα
tip-eject = Λαβή εκτίναξης
    .desc = Εκτίναξη
tip-master-caution = Master caution
    .desc = Ανάβει με νέες προειδοποιήσεις και επισημάνσεις· τις επιβεβαιώνει και σιγάζει τους συναγερμούς
tip-hud-mode = Λειτουργία HUD
    .desc = NAV, AIR, GND
tip-bomb-mode = Λειτουργία βομβαρδισμού
    .desc = CCIP / CCRP
tip-hud-declutter = HUD declutter
tip-maps = Σελίδα αριστερού MFD
    .desc = Χάρτης / τακτική
tip-nvg = Γυαλιά νυχτερινής όρασης
tip-ordnance = Σελίδα όπλων
    .desc = Δεξί MFD
tip-flir = FLIR
    .desc = Εικόνα υπερύθρων ενεργή / ανενεργή
tip-ils = ILS
    .desc = Σύστημα προσγείωσης με όργανα: καθοδήγηση προσγείωσης και ράβδοι οδήγησης του HUD
tip-mission-orders = Εντολές αποστολής
tip-cam-ahead = Κάμερα παρακολούθησης
    .desc = Κοιτά μπροστά
tip-cam-rear = Κάμερα παρακολούθησης
    .desc = Κοιτά πίσω
tip-cam-right = Κάμερα παρακολούθησης
    .desc = Κοιτά δεξιά
tip-cam-left = Κάμερα παρακολούθησης
    .desc = Κοιτά αριστερά
tip-designate-target = Ορισμός στόχου
    .desc = Αναβοσβήνει όσο ένας στόχος είναι ορισμένος, σταθερό εντός της εμβέλειας του όπλου
tip-select-target = Επόμενος στόχος
    .desc = Επιλογή του επόμενου στόχου
tip-nearest-target = Κοντινότερος στόχος
    .desc = Κλείδωμα του κοντινότερου στόχου μπροστά
tip-clear-target = Άρση στόχου
    .desc = Καμία αυτόματη σύλληψη μέχρι το επόμενο πλήκτρο στόχου· η κάψουλα στόχευσης κοιτά το σημείο πορείας
tip-select-weapon = Επιλογή όπλου
    .desc = Το επόμενο όπλο, μετά το τελευταίο το πυροβόλο
tip-fire-weapon = Βολή
    .desc = Ρίψη του επιλεγμένου όπλου
tip-flare = Flare
    .desc = Ρίψη flare (κατά πυραύλων υπερύθρων)
tip-chaff = Chaff
    .desc = Ρίψη chaff (κατά πυραύλων radar)
tip-decoy = Παραπλανητικός στόχος
    .desc = Ρίψη παραπλανητικού στόχου
tip-ecm = ECM
    .desc = Παρεμβολέας radar ενεργός / ανενεργός (αναμμένο όταν είναι ενεργός)
tip-ir-jammer = IR jammer
    .desc = Ενεργός / ανενεργός· σβήνει μόνος του μετά από 20 s και πρέπει να κρυώσει
tip-select-waypoint = Waypoints
    .desc = Σελίδα waypoint
tip-change-waypoint = Επεξεργασία waypoints
    .desc = Το αριθμητικό πληκτρολόγιο μετακινεί το επιλεγμένο waypoint
tip-reset-waypoint = Επαναφορά waypoints
