# Τα tooltips του πιλοτηρίου (src/cockpit3d/tooltips.rs). Ένας τίτλος που είναι ένδειξη του
# πιλοτηρίου (λυχνία, κουμπί, αρκτικόλεξο) μένει στα αγγλικά· οι περιγραφές μεταφράζονται.

## Ενδείξεις οργάνων

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (από 0 έως 99)
tip-wings-level = φτερά οριζόντια
tip-bank-right = κλίση { $deg }° δεξιά
tip-bank-left = κλίση { $deg }° αριστερά
tip-attitude-readout = Πρόνευση { $pitch }°, { $bank }
tip-heading = Πορεία { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° σε { $distance }
tip-nozzle-open = ανοιχτό κατά { $value } %
tip-key = Πλήκτρο: { $key }
tip-keys = Πλήκτρα: { $keys }

## Ενέργειες: το όνομα, μετά τι κάνουν

tip-gear = Σύστημα προσγείωσης
