# Cockpittets tooltips (src/cockpit3d/tooltips.rs). En titel, der er cockpittets egen mærkat
# (lampe, knap, forkortelse), forbliver på engelsk; beskrivelserne er oversat.

## Aflæsninger

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (0 til 99)
tip-wings-level = vinger vandret
tip-bank-right = krængning { $deg }° til højre
tip-bank-left = krængning { $deg }° til venstre
tip-attitude-readout = Stigning { $pitch }°, { $bank }
tip-heading = Kurs { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° på { $distance }
tip-nozzle-open = { $value } % åben
tip-nozzles = Dyser { $deg }°
tip-key = Tast: { $key }
tip-keys = Taster: { $keys }

