bt-destroy-0 = Distruggere { $what }
bt-destroy-1 = Neutralizzare { $what }
bt-destroy-2 = Colpire { $what }
bt-suffix-deadline-0 = {" "}entro e non oltre le ore { $deadline }.
bt-suffix-deadline-1 = {" "}entro le ore { $deadline }.
bt-suffix-deadline-2 = {" "}prima delle ore { $deadline }.
bt-suffix-unloading-0 = {" "}entro le ore { $deadline }, finché il carico è ancora lì.
bt-suffix-unloading-1 = {" "}prima delle ore { $deadline }, durante lo scarico.
