bt-drop-0 = Lanciare i rifornimenti sul radiofaro nel quadrante { $coord }. Trasmette fino alle ore { $deadline }.
bt-drop-1 = Sganciare il carico sopra il radiofaro nel quadrante { $coord } prima delle ore { $deadline }.
bt-drop-2 = Consegnare il contenitore di rifornimenti al radiofaro nel quadrante { $coord } entro le ore { $deadline }.
bt-airstrip-0 = Atterrare sulla pista nel quadrante { $coord } prima delle ore { $deadline } e imbarcare il carico.
bt-airstrip-1 = Atterrare nel quadrante { $coord } entro le ore { $deadline } per recuperare il carico.
bt-airstrip-2 = Effettuare il recupero sulla pista nel quadrante { $coord } prima delle ore { $deadline }.
bt-route-0 = Un aereo da trasporto parte da { $origin } alle ore { $depart } diretto a { $place }. Abbatterlo prima delle ore { $deadline }.
bt-route-1 = Intercettare il trasporto in volo da { $origin } a { $place } (decollo ore { $depart }) entro le ore { $deadline }.
bt-route-2 = Il trasporto decolla da { $origin } alle ore { $depart }, diretto a { $place }. Fermarlo prima delle ore { $deadline }.
bt-leaving-0 = Un aereo da trasporto decolla da { $place } alle ore { $depart }. Abbatterlo.
bt-leaving-1 = Intercettare il trasporto in partenza da { $place } alle ore { $depart }.
bt-leaving-2 = Fermare il velivolo in partenza da { $place } alle ore { $depart }.
bt-last-seen-0 = Il velivolo è stato avvistato l'ultima volta nel quadrante { $coord } alle ore { $depart }, diretto a { $place }. Abbatterlo prima delle ore { $deadline }.
bt-last-seen-1 = Intercettare entro le ore { $deadline } il velivolo avvistato nel quadrante { $coord } alle ore { $depart } in rotta verso { $place }.
bt-last-seen-2 = Rintracciare il velivolo visto nel quadrante { $coord } alle ore { $depart }, diretto a { $place }. Fermarlo prima delle ore { $deadline }.
bt-patrol-0 = Abbattere il { $target } nei pressi del quadrante { $coord }.
bt-patrol-1 = Distruggere il { $target } che opera attorno al quadrante { $coord }.
bt-patrol-2 = Ingaggiare il { $target } nei pressi del quadrante { $coord }.
