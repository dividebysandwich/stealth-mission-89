# I messaggi del gioco sull'HUD e sui pannelli 2D del volo. L'HUD li mostra in maiuscolo
# senza accenti; le parole dell'avionica (CCIP, THR, KM, MAX...) restano in inglese.

hud-no-ejection-seat = NESSUN SEGGIOLINO EIETTABILE
hud-waypoint-reached = Waypoint { $waypoint } raggiunto
hud-select-camera = SCEGLIERE LA CAMERA
hud-open-bay = APRIRE LA STIVA
hud-camera-page = PAGINA { $page }
hud-target-in-view-shoot = OBIETTIVO IN VISTA - SCATTARE
hud-target-in-view = OBIETTIVO IN VISTA
hud-aim-at-target = PUNTARE L'OBIETTIVO
hud-photo = FOTO { $state }
hud-rearmed = Riarmato e rifornito
hud-landed-rearm = Atterrato - riarmare o terminare la sortita
hud-objective-achieved = Obiettivo raggiunto

## Schermata di fine missione

end-accomplished = compiuto
end-not-accomplished = non compiuto
end-primary = Obiettivo primario { $result }
end-secondary = Obiettivo secondario { $result }
end-kills = Abbattimenti: { $air } aerei, { $ground } obiettivi a terra
end-time = Durata della missione { $time }
end-damage = Danni: { $hits } colpi
end-training = Missione di addestramento
end-press-any-key = Premere un tasto

## Il pannello del pilota abbattuto

csar-flare = RAZZO DI SEGNALAZIONE
csar-faster = PIÙ VELOCE
csar-normal = TEMPO NORMALE
csar-skip = SALTARE L'ESTRAZIONE
csar-parachute = PARACADUTE APERTO
csar-on-ground = A TERRA
csar-down = A TERRA IN TERRITORIO NEMICO
csar-pickup = SOCCORSO   UH-60 SULLA VERTICALE - RECUPERO
csar-inbound = SOCCORSO   UH-60 A { $km } KM { $direction } - IN AVVICINAMENTO
csar-fire-flare = SOCCORSO   UH-60 A { $km } KM { $direction } - SPARARE UN RAZZO QUANDO È VICINO
csar-enemy = NEMICI   { $count } HIND, IL PIÙ VICINO A { $km } KM
csar-flares = RAZZI   { $count }      A TERRA DA { $time }

## Notifiche della cooperativa sul pannello, nota della console di difesa aerea

notice-joined = { $pilot } si è unito alla partita
notice-left = { $pilot } ha lasciato
notice-lost-connection = { $pilot } ha perso la connessione
st-select-track = Selezionare prima una traccia
