# Stealth Mission 89: parole comuni a tutte le schermate (vedere en/common.ftl e glossary.md).

language = Lingua
    .facts =
        La lingua dei menu, dei tooltip, dei briefing e dei messaggi
        Le scritte del cockpit (HUD, MFD, pannello) restano in inglese, come nell'aereo reale

## Pulsanti

back = INDIETRO
    .facts = Torna alla schermata precedente
ok = OK
cancel = ANNULLARE
close = CHIUDERE
continue = CONTINUARE
yes = SÌ
no = NO
on = ATTIVO
off = DISATTIVO
classic = CLASSICO
modern = MODERNO

## Test del sistema di traduzione

i18n-test-count = { $n ->
    [one] { $n } colpo
   *[other] { $n } colpi
}
i18n-test-lines =
    Prima riga
    Seconda riga
i18n-test-nested = Scegliere: { $what }
