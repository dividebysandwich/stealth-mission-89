# I tooltip del cockpit (src/cockpit3d/tooltips.rs). Un titolo che è la scritta del cockpit
# (spia, pulsante, sigla) resta in inglese; le descrizioni sono tradotte.

## Letture degli strumenti

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (da 0 a 99)
tip-wings-level = ali livellate
tip-bank-right = inclinazione { $deg }° a destra
tip-bank-left = inclinazione { $deg }° a sinistra
tip-attitude-readout = Beccheggio { $pitch }°, { $bank }
tip-heading = Prua { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° a { $distance }
tip-nozzle-open = aperto al { $value }%
tip-nozzles = Ugelli { $deg }°
tip-key = Tasto: { $key }
tip-keys = Tasti: { $keys }

## Azioni: il nome, poi che cosa fa

tip-gear = Carrello d'atterraggio
    .desc = Carrello retratto / estratto (la leva mostra la posizione)
tip-autopilot = Pilota automatico
    .desc = Vola verso il waypoint attuale (Tornado: seguendo il terreno)
tip-bay-doors = Portelloni dei vani armi
    .desc = Aprire / chiudere; le armi si sganciano solo con i vani aperti
tip-flaps = Flap
    .desc = Più portanza, velocità di stallo circa il 20% più bassa
tip-brakes = Freni
    .desc = Freni delle ruote a terra, aerofreno in volo
tip-eject = Maniglia di eiezione
    .desc = Eiettarsi
tip-master-caution = Master caution
    .desc = Si accende con nuovi allarmi e avvisi; li conferma e silenzia gli allarmi
tip-hud-mode = Modo HUD
    .desc = NAV, AIR, GND
tip-bomb-mode = Modo di bombardamento
    .desc = CCIP / CCRP
tip-hud-declutter = Declutter dell'HUD
tip-maps = Pagina dell'MFD sinistro
    .desc = Mappa / tattico
tip-nvg = Visori notturni
tip-ordnance = Pagina delle armi
    .desc = MFD destro
tip-flir = FLIR
    .desc = Immagine a infrarossi accesa / spenta
tip-ils = ILS
    .desc = Sistema di atterraggio strumentale: guida all'atterraggio e barre di guida dell'HUD
tip-mission-orders = Ordini di missione
tip-cam-ahead = Telecamera di puntamento
    .desc = Guarda in avanti
tip-cam-rear = Telecamera di puntamento
    .desc = Guarda indietro
tip-cam-right = Telecamera di puntamento
    .desc = Guarda a destra
tip-cam-left = Telecamera di puntamento
    .desc = Guarda a sinistra
tip-designate-target = Designare il bersaglio
    .desc = Lampeggia quando un bersaglio è designato, fisso entro la portata dell'arma
tip-select-target = Bersaglio successivo
    .desc = Selezionare il bersaglio successivo
tip-nearest-target = Bersaglio più vicino
    .desc = Agganciare il bersaglio più vicino davanti
tip-clear-target = Cancellare il bersaglio
    .desc = Nessuna acquisizione automatica fino al prossimo tasto bersaglio; il pod di designazione guarda il punto di rotta
tip-select-weapon = Selezione dell'arma
    .desc = L'arma successiva, dopo l'ultima il cannone
tip-fire-weapon = Fuoco
    .desc = Sganciare o lanciare l'arma selezionata
tip-flare = Flare
    .desc = Lanciare un flare (contro i missili a infrarossi)
tip-chaff = Chaff
    .desc = Lanciare chaff (contro i missili radar)
tip-decoy = Esca
    .desc = Lanciare un'esca
tip-ecm = ECM
    .desc = Disturbatore radar acceso / spento (illuminato quando attivo)
tip-ir-jammer = Disturbatore IR
    .desc = Acceso / spento; si spegne da solo dopo 20 s e deve raffreddarsi
tip-select-waypoint = Waypoint
    .desc = Pagina dei waypoint
tip-change-waypoint = Modificare i waypoint
    .desc = Il tastierino numerico sposta il waypoint selezionato
tip-reset-waypoint = Ripristinare i waypoint
    .desc = Tutti i waypoint tornano alla posizione pianificata
tip-last-waypoint = Waypoint precedente
tip-next-waypoint = Waypoint successivo
tip-menu = Menu delle impostazioni
    .desc = Apre o chiude il menu in volo
tip-volume = Volume audio
tip-detail = Livello di dettaglio
tip-time-accel = Accelerazione del tempo
    .desc = Ogni pressione accelera di più: ACCEL, x2, x3, poi tempo normale. Termina quando un radar rileva il velivolo o viene sganciata un'arma
tip-time-normal = Tempo normale
tip-map-zoom-in = Zoom avanti della mappa
    .desc = Lo zoom del pod di designazione quando è il SOI
tip-map-zoom-out = Zoom indietro della mappa
    .desc = Lo zoom del pod di designazione quando è il SOI
tip-map-orientation = Orientamento della mappa
    .desc = Nord in alto / prua in alto
tip-lock-cursor = Agganciare sotto il cursore
    .desc = Agganciare ciò che è sotto il cursore del sensore
tip-swap-soi = Sensore d'interesse (SOI)
    .desc = Passa sull'altro MFD
tip-kneeboard = Kneeboard
    .desc = Mostrarlo sopra la visuale, pagina successiva, nasconderlo
tip-chat = Chat
    .desc = Scrivere un messaggio agli altri giocatori
tip-camera-zoom-in = Zoom avanti della telecamera
    .desc = La portata dell'HSD quando è il SOI
tip-camera-zoom-out = Zoom indietro della telecamera
    .desc = La portata dell'HSD quando è il SOI

