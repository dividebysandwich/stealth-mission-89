# Los mensajes del juego en el HUD y en los paneles 2D del vuelo. El HUD los muestra en
# mayúsculas sin acentos; las palabras de la aviónica (CCIP, THR, KM, MAX...) quedan en inglés.

hud-no-ejection-seat = SIN ASIENTO EYECTABLE
hud-waypoint-reached = Waypoint { $waypoint } alcanzado
hud-select-camera = ELEGIR CÁMARA
hud-open-bay = ABRIR LA BODEGA
hud-camera-page = PÁGINA { $page }
hud-target-in-view-shoot = OBJETIVO A LA VISTA - FOTO
hud-target-in-view = OBJETIVO A LA VISTA
hud-aim-at-target = APUNTAR AL OBJETIVO
hud-photo = FOTO { $state }
hud-rearmed = Rearmado y repostado
hud-landed-rearm = En tierra - rearme o termine la salida
hud-objective-achieved = Objetivo cumplido

## Pantalla de fin de misión

end-accomplished = cumplido
end-not-accomplished = no cumplido
end-primary = Objetivo principal { $result }
end-secondary = Objetivo secundario { $result }
end-kills = Derribos: { $air } aviones, { $ground } objetivos terrestres
end-time = Duración de la misión { $time }
end-damage = Daños: { $hits } impactos
end-training = Misión de entrenamiento
end-press-any-key = Pulse cualquier tecla

## El panel del piloto derribado

csar-flare = BENGALA DE SEÑALES
csar-faster = MÁS RÁPIDO
csar-normal = TIEMPO NORMAL
csar-skip = SALTAR LA EXTRACCIÓN
csar-parachute = PARACAÍDAS ABIERTO
csar-on-ground = EN TIERRA
csar-down = DERRIBADO EN TERRITORIO ENEMIGO
csar-pickup = RESCATE   UH-60 ENCIMA - RECOGIDA
csar-inbound = RESCATE   UH-60 A { $km } KM { $direction } - EN APROXIMACIÓN
csar-fire-flare = RESCATE   UH-60 A { $km } KM { $direction } - DISPARE UNA BENGALA CUANDO ESTÉ CERCA
csar-enemy = ENEMIGOS   { $count } HIND, EL MÁS CERCANO A { $km } KM
csar-flares = BENGALAS   { $count }      EN TIERRA DESDE { $time }

## Avisos de la cooperativa en el panel, nota de la consola de defensa aérea

notice-joined = { $pilot } se ha unido
notice-left = { $pilot } se ha ido
notice-lost-connection = { $pilot } ha perdido la conexión
st-select-track = Seleccione primero una traza
