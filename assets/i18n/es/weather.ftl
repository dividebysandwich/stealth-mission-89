# La meteorología de los briefings y de la pantalla de operaciones. Los nombres de las nubes
# son los internacionales.

wx-cumulus = cumulus
wx-cumulonimbus = cumulonimbus
wx-altostratus = altostratus
wx-stratus = stratus
wx-stratocumulus = stratocumulus
wx-clear = Meteo: despejado, visibilidad { $vis } km.
wx-layer = { $name } { $cover } % desde { $base } ft
wx-layer-top = { $name } { $cover } % { $base }-{ $top } ft
wx-line = Meteo: { $sky } - { $layers }, visibilidad { $vis } km.
wx-sky-clear = despejado
wx-sky-scattered = nubes dispersas
wx-sky-broken = nubes fragmentadas
wx-sky-overcast = cubierto
wx-sky-storm = tormentas
