# Los tooltips de la cabina (src/cockpit3d/tooltips.rs). Un título que es la inscripción de la
# cabina (luz, botón del marco o de la consola, sigla) sigue en inglés en todos los idiomas;
# las descripciones se traducen.

## Lecturas de los instrumentos

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (de 0 a 99)
tip-wings-level = alas niveladas
tip-bank-right = alabeo { $deg }° a la derecha
tip-bank-left = alabeo { $deg }° a la izquierda
tip-attitude-readout = Cabeceo { $pitch }°, { $bank }
tip-heading = Rumbo { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° a { $distance }
tip-nozzle-open = abierta al { $value } %
tip-key = Tecla: { $key }
tip-keys = Teclas: { $keys }

## Acciones: el nombre y luego lo que hace

tip-gear = Tren de aterrizaje
    .desc = Tren arriba / abajo (la palanca muestra la posición)
tip-autopilot = Piloto automático
    .desc = Vuela hacia el waypoint actual (Tornado: siguiendo el terreno)
tip-bay-doors = Compuertas de las bodegas
    .desc = Abrir / cerrar; las armas solo se lanzan con las bodegas abiertas
tip-flaps = Flaps
    .desc = Más sustentación, velocidad de pérdida un 20 % más baja aproximadamente
tip-brakes = Frenos
    .desc = Frenos de ruedas en tierra, aerofreno en vuelo
tip-eject = Maneta de eyección
    .desc = Eyectarse
tip-master-caution = Master caution
    .desc = Silencia las alarmas: incendio, pérdida y avisos de radar
tip-hud-mode = Modo del HUD
    .desc = NAV, AIR, GND
tip-bomb-mode = Modo de bombardeo
    .desc = CCIP / CCRP
tip-hud-declutter = Despejar el HUD
tip-maps = Página del MFD izquierdo
    .desc = Mapa / táctico
tip-nvg = Gafas de visión nocturna
tip-ordnance = Página de armas
    .desc = MFD derecho
tip-flir = FLIR
    .desc = Imagen infrarroja sí / no
tip-ils = ILS
    .desc = Sistema de aterrizaje por instrumentos: guiado en el aterrizaje y barras de dirección del HUD
tip-mission-orders = Órdenes de misión
tip-cam-ahead = Cámara de seguimiento
    .desc = Mira hacia delante
tip-cam-rear = Cámara de seguimiento
    .desc = Mira hacia atrás
tip-cam-right = Cámara de seguimiento
    .desc = Mira a la derecha
tip-cam-left = Cámara de seguimiento
    .desc = Mira a la izquierda
tip-designate-target = Designar blanco
    .desc = Parpadea mientras hay un blanco designado, fija dentro del alcance del arma
tip-select-target = Blanco siguiente
    .desc = Seleccionar el blanco siguiente
tip-nearest-target = Blanco más cercano
    .desc = Fijar el blanco más cercano por delante
tip-clear-target = Borrar blanco
    .desc = Sin adquisición automática hasta la siguiente tecla de blanco
tip-select-weapon = Seleccionar arma
    .desc = El arma siguiente; después de la última, el cañón
tip-fire-weapon = Disparo
    .desc = Lanzar o disparar el arma seleccionada
tip-flare = Bengala
    .desc = Lanzar una bengala (contra misiles infrarrojos)
tip-chaff = Chaff
    .desc = Lanzar chaff (contra misiles radar)
tip-decoy = Señuelo
    .desc = Lanzar un señuelo
tip-ecm = ECM
    .desc = Perturbador radar sí / no (encendido cuando está activo)
tip-ir-jammer = Perturbador IR
    .desc = Sí / no; se apaga solo a los 20 s y debe enfriarse
tip-select-waypoint = Waypoints
    .desc = Página de waypoints
tip-change-waypoint = Cambiar de waypoint
tip-reset-waypoint = Reiniciar el waypoint
tip-last-waypoint = Waypoint anterior
tip-next-waypoint = Waypoint siguiente
tip-menu = Menú de ajustes
    .desc = Abre o cierra el menú en vuelo
tip-volume = Volumen del sonido
tip-detail = Nivel de detalle
tip-time-accel = Aceleración del tiempo
