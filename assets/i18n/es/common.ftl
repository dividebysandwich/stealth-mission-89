# Stealth Mission 89: palabras comunes a todas las pantallas (ver en/common.ftl y glossary.md).

language = Idioma
    .facts =
        El idioma de los menús, los tooltips, los briefings y los mensajes
        Las inscripciones de la cabina (HUD, MFD, panel) siguen en inglés, como en el avión real

## Botones

back = VOLVER
    .facts = Volver a la pantalla anterior
ok = ACEPTAR
cancel = CANCELAR
close = CERRAR
continue = CONTINUAR
yes = SÍ
no = NO
on = ACTIVADO
off = DESACTIVADO
classic = CLÁSICO
modern = MODERNO

