input-title = ASIGNAREA COMENZILOR
input-clear-all = ȘTERGE TOT
    .facts = Elimină toate atribuirile de axe și butoane ale joystick-ului (tastele rămân)
input-clear-all-done = Toate atribuirile joystickului au fost eliminate
input-default-keys = TASTE IMPLICITE
    .facts = Restabilește tastele implicite ale tastaturii
input-default-keys-done = Tastele implicite au fost restabilite
input-default-joystick = JOYSTICK IMPLICIT
    .facts = Elimină atribuirile tale pentru joystick și folosește din nou aranjamentele încorporate ale joystickurilor și gamepadurilor cunoscute
input-default-joystick-done = Atribuirile joystickului au revenit la aranjamentele încorporate
input-no-joysticks = NICIUN JOYSTICK DETECTAT  (conectați un dispozitiv; va apărea aici)
input-gamepad = Configurație standard de gamepad
    .facts = Stick stânga, stick dreapta direcție, trigger-e manetă, butoane frontale foc / tun / arme / compartiment. Back / Select tren, apăsarea stick-urilor rachete termice / chaff, cruce ținte. Un buton sau o axă atribuite aici fac doar ceea ce li s-a atribuit. Dezactivați dacă butoanele unui joystick fac lucruri cărora nu le sunt atribuite.
input-device-defaults = Configurații încorporate pentru joystick-uri cunoscute
    .facts = Mantele, manetele de gaz și pedalierele cunoscute (Thrustmaster, Logitech/Saitek, VKB, Virpil, CH, Honeycomb, MOZA) vin cu axele și butoanele atribuite. O comandă pe care o atribui sau o ștergi tu are prioritate față de configurație.
input-ffb = Force feedback
    .facts = Intensitatea forțelor pe manșa unei baze cu force feedback (MOZA AB6, AB9): o centrare care se întărește cu viteza, vibrațiile dinaintea angajării, huruitul pe pistă, aterizările și tunul. 0% îl oprește. Setează jos arcul și amortizarea proprii ale bazei în MOZA Cockpit.
input-builtin = Configurația încorporată a acestui dispozitiv: atribuie sau șterge pentru a o schimba
input-help = Apăsați BIND, apoi mișcați o axă sau apăsați un buton; + adaugă o tastă. Esc anulează.
input-undo = ANULEAZĂ
    .facts = Readuce atribuirile la starea de dinainte
input-was = (era: { $what })
input-preview-help = Aeronava din dreapta arată ce fac axele asignate: inversați o axă dacă se mișcă în sens greșit.
input-no-match = NICIUN REZULTAT
input-axes = AXE
input-invert = Inversare
input-dead-zone = zonă moartă
input-curve = Curbă
input-expo = Curbă de răspuns
    .facts = 0%: dreaptă. Mai mult: mai fină în centru, la fel de rapidă la capete
input-saturation = Saturație
    .facts = Cursa care dă valoarea întreagă: sub 100% axa ajunge mai devreme la capăt
input-curve-straight = DREAPTĂ
input-move-it = mișcați-o
input-axis-or-button = MIȘCAȚI O AXĂ SAU APĂSAȚI UN BUTON PENTRU { $action }...
input-button-for = ACUM APĂSAȚI UN BUTON PENTRU { $action }...
