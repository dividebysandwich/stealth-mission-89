# Il-messaġġi tal-logħba fuq l-HUD u fuq l-overlays 2D tat-titjira (src/hud, src/combat.rs,
# src/csar_view.rs, src/campaign). L-HUD jiżbaljahom bil-kapitali mingħajr aċċenti; il-kliem
# tal-avjonika nnifisha (CCIP, THR, KM, MAX...) jibqa' bl-Ingliż.

hud-no-ejection-seat = L-EBDA SEDJA TAL-EJEZZJONI
hud-waypoint-reached = Waypoint { $waypoint } intlaħaq
hud-select-camera = AGĦŻEL IL-KAMERA
hud-open-bay = IFTAĦ IL-BAY
hud-camera-page = PAĠNA { $page }
hud-target-in-view-shoot = MIRA FIL-VIST - RITRATT
hud-target-in-view = MIRA FIL-VIST
hud-aim-at-target = IMMIRA LEJN IL-MIRA
hud-photo = RITRATT { $state }
hud-rearmed = Armat mill-ġdid u mimli bil-fuel
hud-landed-rearm = Inżilt - erġa' armi jew għalaq it-titjira
hud-objective-achieved = Għan milħuq

## Overlay tat-tmiem tal-missjoni

end-accomplished = mwettaq
end-not-accomplished = mhux mwettaq
end-primary = Għan primarju { $result }
end-secondary = Għan sekondarju { $result }
end-kills = Qtil: { $air } inġenji tal-ajru, { $ground } miri fl-art
end-time = Ħin tal-missjoni { $time }
end-damage = Ħsara: { $hits } daqqiet
end-training = Missjoni ta' taħriġ
end-press-any-key = Agħfas kwalunkwe buttuna

## Il-pannell tal-pilota mwaqqa'

csar-flare = FLARE TA' SINJAL
csar-faster = AKTAR MALAJR
csar-normal = ĦIN NORMALI
csar-skip = TOLOQ L-ESTRAZZJONI
csar-parachute = PARAXUT MIFTUĦ
csar-on-ground = FL-ART
csar-down = MWAQQA' FIT-TERRITORJU TAL-GĦADU
csar-pickup = SALVATAĠĠ   UH-60 FUQNA - ĠBIR
