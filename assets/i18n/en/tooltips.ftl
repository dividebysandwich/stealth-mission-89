# The cockpit tooltips (src/cockpit3d/tooltips.rs). A title that is the cockpit's own label
# (a lamp, a bezel or console button, an acronym) stays in English in every language; the
# descriptions are translated.

## Readouts

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (0 to 99)
tip-wings-level = wings level
tip-bank-right = bank { $deg }° right
tip-bank-left = bank { $deg }° left
tip-attitude-readout = Pitch { $pitch }°, { $bank }
tip-heading = Heading { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° at { $distance }
tip-nozzle-open = { $value } % open
tip-nozzles = Nozzles { $deg }°
tip-key = Key: { $key }
tip-keys = Keys: { $keys }

## Actions: the name, then what it does

tip-gear = Landing gear
    .desc = Gear up / down (the lever shows the position)
tip-autopilot = Autopilot
    .desc = Flies to the current waypoint (Tornado: following the terrain)
tip-bay-doors = Weapon bay doors
    .desc = Open / close; weapons are released with open bays only
tip-flaps = Flaps
    .desc = More lift, about 20 % lower stall speed
tip-brakes = Brakes
    .desc = Wheel brakes on the ground, speed brake in the air
tip-eject = Ejection handle
    .desc = Eject
tip-master-caution = Master caution
    .desc = Lit by new warnings and cautions; acknowledges them and silences the alarms
tip-hud-mode = HUD mode
    .desc = NAV, AIR, GND
tip-bomb-mode = Bombing mode
    .desc = CCIP / CCRP
tip-hud-declutter = HUD declutter
tip-maps = Left MFD page
    .desc = Map / tactical
tip-nvg = Night vision goggles
tip-ordnance = Weapons page
    .desc = Right MFD
tip-flir = FLIR
    .desc = Infrared picture on / off
tip-ils = ILS
    .desc = Instrument landing system: landing guidance and the HUD steering bars
tip-mission-orders = Mission orders
tip-cam-ahead = Tracking camera
    .desc = Looking ahead
tip-cam-rear = Tracking camera
    .desc = Looking to the rear
tip-cam-right = Tracking camera
    .desc = Looking right
tip-cam-left = Tracking camera
    .desc = Looking left
tip-designate-target = Designate target
    .desc = Blinks while a target is designated, steady within weapon range
tip-select-target = Next target
    .desc = Select the next target
tip-nearest-target = Nearest target
    .desc = Lock the nearest target ahead
tip-clear-target = Clear target
    .desc = No automatic acquisition until the next target key
tip-select-weapon = Select weapon
    .desc = The next weapon, after the last one the gun
tip-fire-weapon = Fire
    .desc = Release the selected weapon
tip-flare = Flare
    .desc = Release a flare (against infrared missiles)
tip-chaff = Chaff
    .desc = Release chaff (against radar missiles)
tip-decoy = Decoy
    .desc = Release a decoy
tip-ecm = ECM
    .desc = Radar jammer on / off (lit when on)
tip-ir-jammer = IR jammer
    .desc = On / off; switches itself off after 20 s and must cool down
tip-select-waypoint = Waypoints
    .desc = Waypoint page
tip-change-waypoint = Edit waypoints
    .desc = The keypad moves the selected waypoint
tip-reset-waypoint = Reset waypoints
    .desc = All waypoints back to their planned positions
tip-last-waypoint = Previous waypoint
tip-next-waypoint = Next waypoint
tip-menu = Settings menu
    .desc = Opens or closes the in-flight menu
tip-volume = Sound volume
tip-detail = Detail level
tip-time-accel = Time acceleration
    .desc = Ends when a radar detects the aircraft or a weapon is released
tip-time-normal = Normal time
tip-map-zoom-in = Map zoom in
tip-map-zoom-out = Map zoom out
tip-map-orientation = Map orientation
    .desc = North up / heading up
tip-lock-cursor = Lock cursor target
    .desc = Lock what is under the sensor's cursor
tip-swap-soi = Sensor of interest
    .desc = Moves to the other MFD
tip-kneeboard = Kneeboard
    .desc = Show it over the view, next page, hide
tip-chat = Chat
    .desc = Type a message to the other players
tip-camera-zoom-in = Camera zoom in
tip-camera-zoom-out = Camera zoom out

