## Campaign briefings (crates/stealth-host glue.rs)

brief-battery-task = Destroy the guns of the enemy battery pushed forward near our base
brief-shape-guns = GUNS AND MANPADS
brief-shape-battery = GUN BATTERY
brief-shape-airfield = AIRFIELD
brief-shape-carrier = CARRIER
brief-shape-city = CITY
brief-shape-sam = SAM SITE
brief-shape-ship = SHIP
brief-recon = Photograph { $place } and its defences.
brief-sead = { $count } SAM sites and radars defend the place.
brief-cas = { $count } guns and MANPADS teams defend the place.
brief-battery = An enemy battery pushed forward: { $count } guns and a MANPADS team. Destroy them.
brief-strike = The airfield of { $place }.
brief-interdict = The city of { $place }: its stores and factories feed the enemy.
brief-anti-ship = An enemy ship off the coast.
brief-resupply = The { $unit } needs a new stockpile. { $task }
brief-status = { $status }. { $task }
brief-task-recon = Photograph the target: its defences are then known (spotted from twice the range, shorter radar range) for an hour
brief-task-sead = Destroy the SAM sites and radars defending the place
brief-task-cap = Hold the air over the point for 10 minutes or shoot down two enemy aircraft there; a friendly aircraft lost there starts the clock again
brief-task-cas = Destroy the guns and MANPADS teams around the place
brief-task-anti-ship = Sink the enemy ship
brief-task-strike = Destroy the airfield: no enemy aircraft take off from it until it is repaired
brief-task-escort = Cover the insertion helicopters until they land
brief-task-insertion = Helicopters fly troops in from the nearest friendly base; one landing takes the place
brief-task-intercept = Shoot down the enemy's troop helicopters before they land: one landing takes the place
brief-task-defend = Shoot down the enemy strike aircraft before they bomb the airfield
brief-task-interdict = Strike the enemy's rear: a city costs it materiel at once and its income until rebuilt, an airfield its aircraft there
brief-task-csar = Hold the air within 5 km of the downed pilot for 2 minutes while the helicopter picks him up
brief-task-awacs = Shoot down the enemy AWACS: while it is up the enemy sends more patrols, and sends them at you
brief-task-resupply = Fly the stockpile from the airfield to the air defence unit: hover below 30 m within 50 m of it for 10 s while the load goes down
brief-task-heli-insertion = Fly the troops in, your wingmen with you: land within 1.5 km of the target and stay on the ground for 15 s while they get out to take the place
brief-task-heli-csar = Land within 200 m of the downed pilot and wait 30 s for him to board, then land him at a friendly base
brief-task-drones = Shoot down the attack drones before they dive into the target: one getting through destroys it
