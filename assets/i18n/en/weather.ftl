# The weather in the briefings and on the campaign's Ops screen (crates/stealth-mission
# weather.rs). Cloud names are the international ones.

wx-cumulus = cumulus
wx-cumulonimbus = cumulonimbus
wx-altostratus = altostratus
wx-stratus = stratus
wx-stratocumulus = stratocumulus
wx-clear = Weather: clear, visibility { $vis } km.
wx-layer = { $name } { $cover }% from { $base } ft
wx-layer-top = { $name } { $cover }% { $base }-{ $top } ft
wx-line = Weather: { $sky } - { $layers }, visibility { $vis } km.
wx-sky-clear = clear
wx-sky-scattered = scattered
wx-sky-broken = broken
wx-sky-overcast = overcast
wx-sky-storm = thunderstorms
