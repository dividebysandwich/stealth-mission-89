# 조종석 툴팁 (src/cockpit3d/tooltips.rs). 조종석 자체의 라벨(램프, 베젤 또는 콘솔 버튼, 약어)인
# 제목은 모든 언어에서 영어로 유지되고, 설명은 번역됩니다.

## 계기 표시값

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (0~99)
tip-wings-level = 수평 비행
tip-bank-right = 우측으로 { $deg }° 경사
tip-bank-left = 좌측으로 { $deg }° 경사
tip-attitude-readout = 피치 { $pitch }°, { $bank }
tip-heading = 방위 { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $distance }, 방위 { $bearing }°
tip-nozzle-open = { $value } % 열림
tip-key = 키: { $key }
tip-keys = 키: { $keys }

## 동작: 이름, 그리고 기능

tip-gear = 랜딩 기어
    .desc = 기어 올리기 / 내리기 (레버가 위치를 보여줌)
tip-autopilot = 오토파일럿
    .desc = 현재 웨이포인트로 비행 (토네이도: 지형 추종)
tip-bay-doors = 무장 베이 도어
    .desc = 열기 / 닫기. 무기는 베이가 열려 있을 때만 투하됨
tip-flaps = 플랩
    .desc = 양력 증가, 실속 속도 약 20 % 감소
tip-brakes = 브레이크
    .desc = 지상에서는 휠 브레이크, 공중에서는 스피드 브레이크
tip-eject = 탈출 손잡이
    .desc = 탈출
tip-master-caution = Master caution
    .desc = 경보 끄기: 화재, 실속, 레이더 경보
tip-hud-mode = HUD 모드
    .desc = NAV, AIR, GND
tip-bomb-mode = 폭격 모드
    .desc = CCIP / CCRP
tip-hud-declutter = HUD 간소화
tip-maps = 왼쪽 MFD 페이지
    .desc = 지도 / 전술
tip-nvg = 야간 투시경
tip-ordnance = 무장 페이지
    .desc = 오른쪽 MFD
tip-flir = FLIR
    .desc = 적외선 영상 켜기 / 끄기
tip-ils = ILS
    .desc = 계기 착륙 장치: 착륙 유도와 HUD 조향 바
tip-mission-orders = 임무 명령
tip-cam-ahead = 추적 카메라
    .desc = 전방을 봅니다
tip-cam-rear = 추적 카메라
    .desc = 후방을 봅니다
tip-cam-right = 추적 카메라
    .desc = 우측을 봅니다
tip-cam-left = 추적 카메라
    .desc = 좌측을 봅니다
tip-designate-target = 표적 지정
    .desc = 표적이 지정되면 깜박이고, 무기 사거리 안에서는 켜진 채 유지됨
tip-select-target = 다음 표적
    .desc = 다음 표적 선택
tip-nearest-target = 최근접 표적
    .desc = 전방 최근접 표적 락온
tip-clear-target = 표적 해제
    .desc = 다음 표적 키를 누를 때까지 자동 포착 없음
tip-select-weapon = 무기 선택
    .desc = 다음 무기, 마지막 무기 다음은 기관포
tip-fire-weapon = 발사
    .desc = 선택한 무기 투하 / 발사
tip-flare = 플레어
    .desc = 플레어 투하 (적외선 미사일 대응)
tip-chaff = Chaff
    .desc = 채프 투하 (레이더 미사일 대응)
tip-decoy = 디코이
    .desc = 디코이 투하
tip-ecm = ECM
    .desc = 레이더 재머 켜기 / 끄기 (켜지면 점등)
tip-ir-jammer = IR 재머
    .desc = 켜기 / 끄기. 20초 후 저절로 꺼지며 냉각이 필요함
tip-select-waypoint = 웨이포인트
    .desc = 웨이포인트 페이지
tip-change-waypoint = 웨이포인트 변경
tip-reset-waypoint = 웨이포인트 초기화
tip-last-waypoint = 이전 웨이포인트
tip-next-waypoint = 다음 웨이포인트
tip-menu = 설정 메뉴
    .desc = 비행 중 메뉴를 열거나 닫음
tip-volume = 소리 크기
tip-detail = 디테일 수준
tip-time-accel = 시간 가속
    .desc = 레이더가 항공기를 탐지하거나 무기를 투하하면 해제됨
tip-time-normal = 보통 시간
tip-map-zoom-in = 지도 확대
tip-map-zoom-out = 지도 축소
tip-map-orientation = 지도 방향
    .desc = 북쪽 위 / 진행 방향 위
tip-lock-cursor = 커서 표적 락온
    .desc = 센서 커서 아래의 대상을 락온
tip-swap-soi = 관심 센서
    .desc = 다른 MFD로 이동
tip-kneeboard = 니보드
    .desc = 화면 위에 표시, 다음 페이지, 숨기기
tip-chat = 채팅
    .desc = 다른 플레이어에게 메시지 입력
tip-camera-zoom-in = 카메라 확대
tip-camera-zoom-out = 카메라 축소

