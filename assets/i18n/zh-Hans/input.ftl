# 按键和摇杆绑定（src/input_dialog.rs、src/hotas.rs）。

axis-roll = 横滚
axis-pitch = 俯仰
axis-rudder = 方向舵
axis-throttle = 油门
axis-slew-x = 传感器/光标偏移 X
axis-slew-y = 传感器/光标偏移 Y
axis-nozzle = 喷口（鹞式）
axis-tgp-zoom = TGP变焦
axis-look-x = 左右观察
axis-look-y = 上下观察
axis-view-zoom = 视角缩放 拉近 / 拉远
input-button = 按钮 { $n }
input-axis = 轴 { $n }
vr-trigger = 扳机
vr-stick-click = 摇杆按下
vr-stick-up = 摇杆向上
vr-stick-down = 摇杆向下
vr-stick-left = 摇杆向左
vr-stick-right = 摇杆向右
vr-grip = 握把键

input-title = 输入映射
input-clear-all = 全部清除
    .facts = 移除所有摇杆轴和按钮的分配（键盘按键保留）
input-default-keys = 默认按键
    .facts = 恢复键盘的默认按键
input-no-joysticks = 未检测到摇杆  （请连接设备，它会显示在此处）
input-gamepad = 标准手柄布局
    .facts = 左摇杆、右摇杆方向舵、扳机油门、正面按钮射击/机炮/武器/弹舱。在此分配的按钮或轴只做所分配的事。如果摇杆按钮做了未分配的事，请关闭。
input-help = 点击绑定，然后移动一个轴或按下一个按钮；+ 可添加按键。按 Esc 取消。
input-preview-help = 右侧的飞机显示已映射的轴的作用：如果某个轴的运动方向相反，请将其反转。
input-no-match = 无匹配项
input-axes = 轴
input-invert = 反转
input-dead-zone = 死区
input-move-it = 请移动它
input-move-axis = 请移动一个轴...
input-buttons = 按钮
input-keyboard = 键盘
input-joystick = 摇杆
input-press-key = 请按下一个键...
input-mouse-left = 鼠标左键
input-mouse-right = 鼠标右键
input-mouse-middle = 鼠标中键
input-mouse-back = 鼠标后退键
input-mouse-forward = 鼠标前进键
input-mouse-other = 鼠标按键 { $n }
input-press-key-or-mouse = 按一个键，或在“等待中”上按鼠标按键……
input-keyboard-mouse = 键盘 / 鼠标
input-waiting = 等待中
input-add-key = 添加按键（将从其他动作中移除）
input-press-button = 请按下一个按钮...
input-save-failed = 无法保存输入映射：{ $error }
input-clear-search = 清除搜索
input-defaults = 默认
input-vr-trigger-note = 扳机仅在对应的手握住油门杆（左手）或操纵杆（右手）时有效；否则它会按下指尖所指的控件。
input-vr-grab = 抓取按键
input-vr-grab-toggle = 切换式抓取
input-vr-grab-bound = 抓取
input-vr-grab-note = 抓取用于握住操纵杆、油门、弹射手柄和膝板。切换式抓取时，按一次抓住，再按一次松开。
input-left-hand = 左手
input-right-hand = 右手
input-bind = 绑定
input-centre = 居中
input-roll = 横滚
input-pitch = 俯仰
input-rudder = 方向舵
input-left = 左
input-right = 右
input-down = 下
input-up = 上
input-throttle = 油门
input-note = 按键、摇杆和手柄
input-done = 完成
    .facts = 关闭控制分配
