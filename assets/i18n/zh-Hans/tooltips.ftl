# 座舱提示（src/cockpit3d/tooltips.rs）。属于座舱自身标签的标题（指示灯、边框或控制台按钮、缩略语）在所有语言中保持英文；说明文字则翻译。

## 读数

tip-radar-bars-readout = EMV { $emv }，EGR { $egr }，EAR { $ear }（0 至 99）
tip-wings-level = 机翼水平
tip-bank-right = 右倾 { $deg }°
tip-bank-left = 左倾 { $deg }°
tip-attitude-readout = 俯仰 { $pitch }°，{ $bank }
tip-heading = 航向 { $heading }°
tip-heading-waypoint = { $heading }，WP{ $wp }：{ $bearing }°，距离 { $distance }
tip-nozzle-open = 开度 { $value } %
tip-nozzles = 喷口 { $deg }°
tip-key = 按键：{ $key }
tip-keys = 按键：{ $keys }

## 动作：名称及其作用

tip-gear = 起落架
    .desc = 起落架收起 / 放下（手柄显示当前位置）
tip-autopilot = 自动驾驶
    .desc = 飞向当前航路点（Tornado：沿地形飞行）
tip-bay-doors = 武器舱门
    .desc = 打开 / 关闭；只有舱门打开时才能投放武器
tip-flaps = 襟翼
    .desc = 升力增大，失速速度约降低 20 %
tip-brakes = 刹车
    .desc = 地面为机轮刹车，空中为减速板
tip-eject = 弹射手柄
    .desc = 弹射
tip-master-caution = Master caution
    .desc = 有新的警告和注意时点亮；确认它们并关闭警报
tip-hud-mode = HUD 模式
    .desc = NAV、AIR、GND
tip-bomb-mode = 轰炸模式
    .desc = CCIP / CCRP
tip-hud-declutter = HUD 精简
tip-maps = 左 MFD 页面
    .desc = 地图 / 战术
tip-nvg = 夜视镜
tip-ordnance = 武器页
    .desc = 右 MFD
tip-flir = FLIR
    .desc = 红外图像 开 / 关
tip-ils = ILS
    .desc = 仪表着陆系统：着陆引导和 HUD 的操纵指引条
tip-mission-orders = 任务命令
tip-cam-ahead = 跟踪摄像机
    .desc = 朝前看
tip-cam-rear = 跟踪摄像机
    .desc = 朝后看
tip-cam-right = 跟踪摄像机
    .desc = 朝右看
tip-cam-left = 跟踪摄像机
    .desc = 朝左看
tip-designate-target = 指定目标
    .desc = 指定目标时闪烁，进入武器射程后常亮
tip-select-target = 下一个目标
    .desc = 选择下一个目标
tip-nearest-target = 最近目标
    .desc = 锁定前方最近的目标
tip-clear-target = 清除目标
    .desc = 在下一次按目标键之前不再自动截获目标
tip-select-weapon = 选择武器
    .desc = 下一件武器，最后一件之后是机炮
tip-fire-weapon = 发射
    .desc = 发射所选武器
tip-flare = 热诱弹
    .desc = 投放热诱弹（对抗红外导弹）
tip-chaff = Chaff
    .desc = 投放 chaff（对抗雷达导弹）
tip-decoy = 诱饵
    .desc = 投放诱饵
tip-ecm = ECM
    .desc = 雷达干扰器 开 / 关（开启时亮起）
tip-ir-jammer = 红外干扰器
    .desc = 开 / 关；20 秒后自动关闭，需要冷却
tip-select-waypoint = 航路点
    .desc = 航路点页
tip-change-waypoint = 编辑航路点
    .desc = 数字小键盘移动所选航路点
tip-reset-waypoint = 重置航路点
    .desc = 所有航路点回到计划位置
tip-last-waypoint = 上一个航路点
tip-next-waypoint = 下一个航路点
tip-menu = 设置菜单
    .desc = 打开或关闭飞行菜单
tip-volume = 音量
tip-detail = 细节级别
tip-time-accel = 时间加速
    .desc = 雷达发现飞机或投放武器时结束
tip-time-normal = 正常时间
tip-map-zoom-in = 地图放大
tip-map-zoom-out = 地图缩小
tip-map-orientation = 地图朝向
    .desc = 北向上 / 航向上
tip-lock-cursor = 锁定光标目标
    .desc = 锁定传感器光标下的目标
tip-swap-soi = Sensor of interest
    .desc = 移到另一块 MFD
tip-kneeboard = 膝板
    .desc = 叠加显示在视图上，下一页，隐藏
tip-chat = 聊天
    .desc = 向其他玩家输入消息
tip-camera-zoom-in = 摄像机放大
tip-camera-zoom-out = 摄像机缩小

## 显示器命令

tip-cmd-map-page = 地图页
tip-cmd-tac-page = 战术页
tip-cmd-camera-page = 跟踪摄像机页
tip-cmd-way-page = 航路点页
tip-cmd-wpn-page = 武器页
tip-cmd-ord-page = 任务命令页
tip-cmd-map-zoom-in = 地图放大
tip-cmd-map-zoom-out = 地图缩小
tip-cmd-orientation = 地图北向上 / 航向上
tip-cmd-flir = FLIR：红外图像 开 / 关
tip-cmd-cam-ahead = 跟踪摄像机朝前看
tip-cmd-cam-right = 跟踪摄像机朝右看
tip-cmd-cam-rear = 跟踪摄像机朝后看
tip-cmd-cam-left = 跟踪摄像机朝左看
tip-cmd-ils = ILS 开 / 关
tip-cmd-hsd = Horizontal situation display (HSD)：俯视态势
tip-cmd-harm = HARM 瞄准
tip-cmd-tgp = 瞄准吊舱（TGP）
tip-cmd-map = 地图
tip-cmd-sms = 外挂管理（SMS）
tip-cmd-hsi = Horizontal situation indicator (HSI)
tip-cmd-soi = 将此显示器设为 sensor of interest（用移动键控制）
tip-cmd-swap-soi = 将 sensor of interest 切换到另一块 MFD
tip-cmd-hsd-range-up = HSD 量程增大
tip-cmd-hsd-range-down = HSD 量程减小
tip-cmd-hsd-centre = HSD 居中 / 偏置
tip-cmd-map-way = 地图上的航路点
tip-cmd-waypoint-up = 向上移动所选航路点
tip-cmd-waypoint-down = 向下移动所选航路点
tip-cmd-waypoint-left = 向左移动所选航路点
tip-cmd-waypoint-right = 向右移动所选航路点
tip-cmd-sms-orders = 任务命令
tip-cmd-sms-weapons = 武器列表
tip-cmd-ripple-up = 连投：每次投放多一枚炸弹
tip-cmd-ripple-down = 连投：每次投放少一枚炸弹
tip-cmd-ripple-spacing-up = 连投间隔增大
tip-cmd-ripple-spacing-down = 连投间隔减小
tip-cmd-harm-filter = HARM 威胁过滤：全部、SAM、空中
tip-cmd-cam-zoom-in = 摄像机放大
tip-cmd-cam-zoom-out = 摄像机缩小
tip-cmd-cam-zoom-cycle = 摄像机变焦：自动，1X 至 20X
tip-cmd-tgp-sp = 吊舱 snowplow：解除锁定，固定朝前
tip-cmd-tgp-slave = 吊舱恢复随动
tip-cmd-tgp-cz = Cursor zero：吊舱指向当前 steerpoint
tip-hsd-range = HSD 量程，单位 km
tip-osb-waypoint-up = 航路点上移
tip-osb-waypoint-down = 航路点下移
tip-osb-waypoint-left = 航路点左移
tip-osb-waypoint-right = 航路点右移

## 防空控制台按钮（标题是按钮的标签）

tip-console-tracks = 航迹列表
tip-console-site = 发射架、导弹、库存和装填
tip-console-lock = 锁定所选航迹：摄像机跟随它
tip-console-drop = 解除锁定（制导中的导弹转为半主动）
tip-console-guided = 由雷达制导后续导弹：难以被诱骗，一次只能打一个目标
tip-console-semi = 后续导弹沿雷达照射归航：可打多个目标，较易被诱骗；空中的制导导弹转为半主动
tip-console-fire = 向锁定的航迹发射一枚导弹（Gepard：一次点射）
tip-console-launcher = 从此发射架发射；再按一次：选用最先准备好的
tip-console-refill = 用库存为空发射架装填（4 分钟）
tip-console-flir = 热成像或彩色摄像机图像
tip-console-zoom = 摄像机变焦
tip-console-range = 空情图的量程
tip-console-leave = 离开控制台：返回作战
tip-console-auto = 所选无人机重新沿航线飞行
tip-console-manual = 手动驾驶所选无人机：操纵杆和油门
tip-console-track = 将无人机摄像机保持在十字线下的地面上
tip-console-slave = 无人机摄像机回到其航路点（前下方）
tip-console-view = 无人机摄像机：其 TGP，或用于驾驶的前视 FLIR

## 控件

tip-hud-nav = NAV 模式
    .desc = HUD 导航模式：操纵飞向当前航路点
tip-hud-air = AIR 模式（A-A）
    .desc = HUD 空对空模式：空中目标
tip-hud-gnd = GND 模式（A-G）
    .desc = HUD 空对地模式：地面目标；再按一次：CCIP / CCRP
tip-left-mfd = 左 MFD
tip-cam-cycle = 跟踪摄像机方向
    .desc = 下一个方向：前、右、后、左
tip-on-off = 开 / 关。{ $detail }

## 指示灯（标题是指示灯的标签）

tip-lamp-stall = 空速低于失速速度（闪烁）
tip-lamp-trak = 敌方雷达正在跟踪飞机
tip-lamp-ir = 一枚红外导弹在飞行中
tip-lamp-rad = 一枚雷达制导导弹在飞行中
tip-lamp-fire = 机上起火
tip-lamp-eng = 发动机受损
tip-lamp-fc = 火控系统受损
tip-lamp-jam = 干扰器受损：ECM 和 IRJ 失效
tip-lamp-av = 航电受损
tip-lamp-fuel = 燃油系统受损
tip-lamp-bd = 弹舱门受损：舱门保持打开
tip-lamp-chaff-act = Chaff 已投放
    .desc = 投放 chaff 时亮起
tip-lamp-flare-act = 热诱弹已投放
    .desc = 投放热诱弹时亮起
tip-lamp-decoy-act = 诱饵已投放
    .desc = 投放诱饵时亮起
tip-lamp-emv-warn = EMV 告警
    .desc = EMV：每次雷达发现后亮 2 秒
tip-lamp-low-fuel = 燃油低于 1500 lbs 时闪烁

## LED 计数器、仪表、显示器

tip-led-chaff = Chaff
    .desc = 剩余 chaff
tip-led-flares = 热诱弹
    .desc = 剩余热诱弹
tip-led-decoys = 诱饵
    .desc = 剩余诱饵
tip-led-fuel = 燃油
    .desc = 燃油量（lbs）除以 10
tip-led-thrust = 推力
    .desc = 推力百分比
tip-gear-lights = 起落架指示灯
    .desc = 起落架放下时，每个机轮处亮一盏绿灯
tip-dial-airspeed = 空速表
tip-dial-altimeter = 高度表
tip-dial-aoa = AOA 指示器
    .desc = 迎角；进近区间为绿色
tip-dial-vvi = 升降速度表（VVI）
tip-dial-rpm = RPM
    .desc = 发动机转速
tip-dial-ftit = FTIT
    .desc = 风扇涡轮进口温度
tip-dial-oil = 油压
tip-dial-nozzle = 喷口位置
tip-dial-fuel = 燃油量
tip-dial-clock = 时钟
    .desc = 当地时间
tip-dial-nozzle-angle = 喷口角度
    .desc = 从向后转向向下：90° 悬停，98.5° 制动
tip-radar-bars = EGR / EAR
    .desc = 雷达条形图：敌方雷达信号与飞机的 EMV 对比
tip-display-left = 左 MFD
    .desc = 多功能显示器
tip-display-centre = 中央显示器
    .desc = 右 MFD 的页面
tip-display-centre-mfd = 中央 MFD
    .desc = 右 MFD 的页面
tip-display-right = 右 MFD
    .desc = 多功能显示器
tip-display-third = 第三块 MFD
    .desc = 初始为 HSI 页
tip-display-adi = 姿态仪
    .desc = 俯仰和坡度
tip-display-approach = AOA 指示灯
    .desc = 慢：红色上箭头，速度正好：绿色圆圈，快：琥珀色下箭头
tip-display-rwr = RWR
    .desc = 雷达告警接收机：显示能看到飞机的雷达
tip-display-tfr = 地形跟随雷达
    .desc = 横向为距离，纵向为角度：显示地形和操纵模板；AUTO 会跟随它
tip-display-hsi = HSI
    .desc = Horizontal situation indicator：航向、到航路点的方位和距离
tip-display-ded = DED
    .desc = 数据输入显示器：无线电、steerpoint、目标、时间和燃油
tip-display-scope = 空情图
    .desc = 阵地周围的航迹，每秒更新两次；点击一条航迹可选中
tip-display-board = 航迹 / 阵地
    .desc = 点击一条航迹可选中；SITE 标签页：发射架和库存
tip-display-eo = 摄像机
    .desc = 锁定的航迹（无人机指挥所：所选无人机的摄像机），彩色或热成像（FLIR）
tip-display-info = 目标数据
    .desc = 锁定的航迹：距离、高度、速度、飞行时间（无人机指挥所：空中的无人机及其电池）
tip-display-feed = 无人机摄像机
    .desc = 所选无人机的摄像机：其 TGP（操纵杆转动）或前视 FLIR，以及速度、高度和航向
tip-display-map = 地面控制站
    .desc = 无人机和接触目标：拖动以平移，点击无人机以选择，拖动其航路点；NEW DRONE 规划发射
tip-stick = 侧置驾驶杆
    .desc = 俯仰和滚转
tip-console-stick = 手控器
    .desc = 未锁定时：移动机炮和摄像机；扳机用于开火
tip-throttle = 油门
    .desc = 推力
tip-nozzle-lever = 喷口杆
    .desc = 向前：喷口向后；向后：向下，直到悬停止动（90°）和制动止动（98.5°）
tip-display-scratchpad = Scratchpad
    .desc = Keyboard display: radio, steerpoint, target, time and fuel
tip-display-lmpd = Left MPD
    .desc = Threats: radars at their range and bearing, missile envelopes, our radar return (inside the dashed ring: unseen) and its last 30 s; warnings (red), cautions (amber), advisories (green) flash until the master caution
tip-display-rmpd = Right MPD
    .desc = Engines: rotor speed, torque, temperatures, oil, fuel and fuel flow
