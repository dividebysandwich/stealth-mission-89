# Tooltipy kokpitu (src/cockpit3d/tooltips.rs). Název, který je vlastním popiskem kokpitu
# (kontrolka, tlačítko na rámečku nebo konzoli, zkratka), zůstává ve všech jazycích anglicky;
# popisy jsou přeložené.

## Údaje

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (0 až 99)
tip-wings-level = křídla vodorovně
tip-bank-right = náklon { $deg }° vpravo
tip-bank-left = náklon { $deg }° vlevo
tip-attitude-readout = Sklon { $pitch }°, { $bank }
tip-heading = Kurz { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° na { $distance }
tip-nozzle-open = otevřeno z { $value } %
tip-nozzles = Trysky { $deg }°
tip-key = Klávesa: { $key }
tip-keys = Klávesy: { $keys }

