# Les tooltips du cockpit (src/cockpit3d/tooltips.rs). Un titre qui est l'inscription du
# cockpit (voyant, bouton, sigle) reste en anglais ; les descriptions sont traduites.

## Lectures des instruments

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (de 0 à 99)
tip-wings-level = ailes à plat
tip-bank-right = inclinaison { $deg }° à droite
tip-bank-left = inclinaison { $deg }° à gauche
tip-attitude-readout = Assiette { $pitch }°, { $bank }
tip-heading = Cap { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp } : { $bearing }° à { $distance }
tip-nozzle-open = ouverte à { $value } %
tip-key = Touche : { $key }
tip-keys = Touches : { $keys }

## Actions : le nom, puis ce qu'elle fait

tip-gear = Train d'atterrissage
    .desc = Train rentré / sorti (le levier montre la position)
tip-autopilot = Pilote automatique
    .desc = Vole vers le waypoint actuel (Tornado : en suivant le terrain)
tip-bay-doors = Portes des soutes
    .desc = Ouvrir / fermer ; les armes ne se larguent que soutes ouvertes
tip-flaps = Volets
    .desc = Plus de portance, vitesse de décrochage environ 20 % plus basse
tip-brakes = Freins
    .desc = Freins de roues au sol, aérofrein en vol
tip-eject = Poignée d'éjection
    .desc = S'éjecter
tip-master-caution = Master caution
    .desc = Coupe les alarmes : incendie, décrochage et alertes radar
tip-hud-mode = Mode du HUD
    .desc = NAV, AIR, GND
tip-bomb-mode = Mode de bombardement
    .desc = CCIP / CCRP
tip-hud-declutter = Désencombrement du HUD
tip-maps = Page du MFD gauche
    .desc = Carte / tactique
tip-nvg = Jumelles de vision nocturne
tip-ordnance = Page des armes
    .desc = MFD droit
tip-flir = FLIR
    .desc = Image infrarouge marche / arrêt
tip-ils = ILS
    .desc = Système d'atterrissage aux instruments : guidage à l'atterrissage et barres de guidage du HUD
tip-mission-orders = Ordres de mission
tip-cam-ahead = Caméra de poursuite
    .desc = Regarde vers l'avant
tip-cam-rear = Caméra de poursuite
    .desc = Regarde vers l'arrière
tip-cam-right = Caméra de poursuite
    .desc = Regarde à droite
tip-cam-left = Caméra de poursuite
    .desc = Regarde à gauche
tip-designate-target = Désigner la cible
    .desc = Clignote quand une cible est désignée, fixe à portée de l'arme
tip-select-target = Cible suivante
    .desc = Sélectionner la cible suivante
tip-nearest-target = Cible la plus proche
    .desc = Verrouiller la cible la plus proche devant
tip-clear-target = Effacer la cible
    .desc = Plus d'acquisition automatique jusqu'à la prochaine touche de cible
tip-select-weapon = Sélection de l'arme
    .desc = L'arme suivante, et après la dernière le canon
tip-fire-weapon = Tir
    .desc = Larguer ou tirer l'arme sélectionnée
tip-flare = Leurre thermique
    .desc = Larguer un leurre thermique (contre les missiles infrarouges)
tip-chaff = Chaff
    .desc = Larguer des paillettes (contre les missiles radar)
tip-decoy = Leurre
    .desc = Larguer un leurre
tip-ecm = ECM
    .desc = Brouilleur radar marche / arrêt (allumé quand actif)
tip-ir-jammer = Brouilleur IR
    .desc = Marche / arrêt ; s'arrête seul après 20 s et doit refroidir
tip-select-waypoint = Waypoints
    .desc = Page des waypoints
tip-change-waypoint = Changer de waypoint
tip-reset-waypoint = Réinitialiser le waypoint
tip-last-waypoint = Waypoint précédent
tip-next-waypoint = Waypoint suivant
tip-menu = Menu des réglages
    .desc = Ouvre ou ferme le menu en vol
tip-volume = Volume sonore
tip-detail = Niveau de détail
tip-time-accel = Accélération du temps
    .desc = S'arrête quand un radar détecte l'appareil ou qu'une arme est larguée
tip-time-normal = Temps normal
tip-map-zoom-in = Zoom avant de la carte
tip-map-zoom-out = Zoom arrière de la carte
tip-map-orientation = Orientation de la carte
    .desc = Nord en haut / cap en haut
tip-lock-cursor = Verrouiller sous le curseur
    .desc = Verrouiller ce qui est sous le curseur du capteur
tip-swap-soi = Capteur d'intérêt (SOI)
    .desc = Passe sur l'autre MFD
tip-kneeboard = Planchette
    .desc = L'afficher sur la vue, page suivante, la masquer
tip-chat = Chat
    .desc = Écrire un message aux autres joueurs
tip-camera-zoom-in = Zoom avant de la caméra
tip-camera-zoom-out = Zoom arrière de la caméra

