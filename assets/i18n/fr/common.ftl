# Stealth Mission 89 : mots communs à tous les écrans (voir en/common.ftl et glossary.md).

language = Langue
    .facts =
        La langue des menus, des tooltips, des briefings et des messages
        Les inscriptions du cockpit (HUD, MFD, panneau) restent en anglais, comme dans l'avion réel

## Boutons

back = RETOUR
    .facts = Retour à l'écran précédent
ok = OK
cancel = ANNULER
close = FERMER
continue = CONTINUER
yes = OUI
no = NON
on = ACTIVÉ
off = DÉSACTIVÉ
classic = CLASSIQUE
modern = MODERNE

## Tests du système de traduction

i18n-test-count = { $n ->
    [one] { $n } impact
   *[other] { $n } impacts
}
i18n-test-lines =
    Première ligne
    Deuxième ligne
i18n-test-nested = Choisir : { $what }
