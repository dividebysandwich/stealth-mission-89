# Les messages du jeu sur le HUD et les panneaux 2D du vol. Le HUD les affiche en majuscules
# sans accents ; les mots de l'avionique (CCIP, THR, KM, MAX...) restent en anglais.

hud-no-ejection-seat = PAS DE SIÈGE ÉJECTABLE
hud-waypoint-reached = Waypoint { $waypoint } atteint
hud-select-camera = CHOISIR LA CAMÉRA
hud-open-bay = OUVRIR LA SOUTE
hud-camera-page = PAGE { $page }
hud-target-in-view-shoot = OBJECTIF EN VUE - PHOTO
hud-target-in-view = OBJECTIF EN VUE
hud-aim-at-target = VISER L'OBJECTIF
hud-photo = PHOTO { $state }
hud-rearmed = Réarmé et ravitaillé
hud-landed-rearm = Posé - réarmez ou terminez la sortie
hud-objective-achieved = Objectif atteint

## Écran de fin de mission

end-accomplished = accompli
end-not-accomplished = non accompli
end-primary = Objectif principal { $result }
end-secondary = Objectif secondaire { $result }
end-kills = Victoires : { $air } appareils, { $ground } objectifs au sol
end-time = Durée de la mission { $time }
end-damage = Dégâts : { $hits } impacts
end-training = Mission d'entraînement
end-press-any-key = Appuyez sur une touche

## Le panneau du pilote abattu

csar-flare = FUSÉE DE DÉTRESSE
csar-faster = PLUS VITE
csar-normal = TEMPS NORMAL
csar-skip = PASSER L'EXTRACTION
csar-parachute = PARACHUTE OUVERT
csar-on-ground = AU SOL
csar-down = AU SOL EN TERRITOIRE ENNEMI
csar-pickup = SAUVETAGE   UH-60 AU-DESSUS - RÉCUPÉRATION
csar-inbound = SAUVETAGE   UH-60 À { $km } KM { $direction } - EN APPROCHE
csar-fire-flare = SAUVETAGE   UH-60 À { $km } KM { $direction } - TIREZ UNE FUSÉE QUAND IL EST PROCHE
csar-enemy = ENNEMIS   { $count } HIND, LE PLUS PROCHE À { $km } KM
csar-flares = FUSÉES   { $count }      AU SOL DEPUIS { $time }

## Notifications de la coopération sur le panneau, note de la console de défense aérienne

notice-joined = { $pilot } a rejoint la partie
notice-left = { $pilot } est parti
notice-lost-connection = { $pilot } a perdu la connexion
st-select-track = Sélectionnez d'abord une piste
