bt-destroy-at-1 = Neutraliser { $what } à { $place }
bt-destroy-at-2 = Frapper { $what } à { $place }
bt-destroy-0 = Détruire { $what }
bt-destroy-1 = Neutraliser { $what }
bt-destroy-2 = Frapper { $what }
