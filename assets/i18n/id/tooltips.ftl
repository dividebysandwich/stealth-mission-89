tip-display-third = MFD ketiga
    .desc = Dimulai pada halaman HSI
tip-display-fourth = MFD keempat
    .desc = Dimulai pada halaman ENG
tip-display-adi = Indikator sikap
    .desc = Pitch dan bank
tip-display-approach = Indexer AOA
    .desc = Lambat: chevron merah di atas, kecepatan pas: lingkaran hijau, cepat: chevron kuning di bawah
tip-display-rwr = RWR
    .desc = Radar warning receiver: radar yang melihat pesawat
tip-display-tfr = Radar pengikut medan
    .desc = Jarak ke samping, sudut ke atas: medan dan templat kemudi; AUTO mengikutinya
tip-display-vdi = VDI
    .desc = Indikator vertikal: cakrawala, lintasan terbang, dan medan di depan
tip-display-phd = PHD
    .desc = Tampilan horizontal pilot: gambar radar di dalam cincin haluannya
tip-display-dvri = DVRI
    .desc = Indikator radar pandangan langsung: gambar radar pencari di dalam cincin haluannya
tip-display-sensor = Layar sensor
    .desc = Gambar pod TRIM: inframerah atau televisi cahaya rendah
tip-display-hsd = HSD
    .desc = Tampilan situasi horizontal: navigasi, gambar TID atau ancaman
tip-display-ddd = DDD
    .desc = Tampilan data rinci: sasaran radar menurut jarak atau kecepatan mendekat
tip-display-tid = TID
    .desc = Tampilan informasi taktis: jejak radar dilihat dari atas
tip-display-ecmd = ECMD
    .desc = Tampilan penangkal elektronik: arah ancaman
tip-display-hsi = HSI
    .desc = Horizontal situation indicator: heading, bearing dan jarak ke waypoint
tip-display-ded = DED
    .desc = Data entry display: radio, steerpoint, sasaran, waktu dan bahan bakar
tip-display-scope = Gambaran udara
    .desc = Track di sekitar situs, dua kali per detik; klik salah satu untuk memilihnya
tip-display-board = Track / situs
    .desc = Klik sebuah track untuk memilihnya; tab SITE: peluncur dan stok
tip-display-eo = Kamera
    .desc = Track yang dikunci (pusat komando drone: kamera drone terpilih), berwarna atau termal (FLIR)
tip-display-info = Data sasaran
    .desc = Track yang dikunci: jarak, ketinggian, kecepatan, waktu terbang (pusat komando drone: drone-dronenya di udara dan baterainya)
tip-display-feed = Kamera drone
    .desc = Kamera drone terpilih: TGP-nya (stick memutarnya) atau FLIR depan, kecepatan, ketinggian, dan arahnya
tip-display-map = Stasiun kendali darat
    .desc = Drone dan kontak: seret untuk menggeser, klik drone untuk memilihnya, seret waypoint-nya; NEW DRONE merencanakan peluncuran
tip-stick = Stik samping
    .desc = Pitch dan roll
tip-console-stick = Pengendali tangan
    .desc = Tanpa kunci: menggeser kanon dan kamera; pemicu menembak
tip-slew-stick = Stik pengarah
    .desc = Mengarahkan pod penargetan
tip-throttle = Throttle (gas)
    .desc = Daya dorong
tip-nozzle-lever = Tuas nozzle
    .desc = Maju: nozzle ke belakang; mundur: ke bawah, sampai penahan hover (90°) dan penahan pengereman (98,5°)
tip-display-scratchpad = Scratchpad
    .desc = Tampilan papan ketik: radio, steerpoint, target, waktu, dan bahan bakar
tip-display-lmpd = Left MPD
    .desc = Ancaman: radar pada jangkauan dan arah dari kita, selubung rudal, gema radar kita (di dalam cincin putus-putus: tidak terlihat) dan 30 dtk terakhirnya; alarm (merah), peringatan (amber) dan pemberitahuan (hijau) berkedip hingga master caution diakui
tip-display-rmpd = Right MPD
    .desc = Mesin: putaran rotor, torsi, suhu, oli, bahan bakar, dan aliran bahan bakar
tip-hover = Melayang otomatis
    .desc = Menahan melayang di titik ini, haluan, dan ketinggian (hingga 30 kt)
tip-hud-colour = Warna HUD
    .desc = Hijau, kuning amber, sian, putih, merah, ungu (HUD dan tampilan helm)
tip-hmd-mode = Tampilan helm
    .desc = Nyala / otomatis (padam saat melihat melalui HUD) / mati
tip-ptt = Radio
    .desc = Tahan untuk berbicara dengan pemain lain
tip-rwr-priority = Mode prioritas RWR
    .desc = Nyala: hanya lima radar paling berbahaya yang ditampilkan
tip-rwr-separate = Pemisahan target RWR
    .desc = Nyala: simbol ancaman yang tumpang tindih digeser menjauh
tip-view-zoom-in = Perbesar tampilan
    .desc = Tahan: mempersempit tampilan kokpit, mendekat di luar
tip-view-zoom-out = Perkecil tampilan
    .desc = Tahan: melebarkan lagi tampilan kokpit, menjauh di luar
tip-display-rmpd-ch47 = Layar tengah
    .desc = Mesin: putaran rotor, torsi, suhu, oli, bahan bakar, dan aliran bahan bakar
