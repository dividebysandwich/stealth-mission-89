# Tooltip kokpit (src/cockpit3d/tooltips.rs). Judul yang merupakan label kokpit itu sendiri
# (lampu, tombol bingkai atau konsol, akronim) tetap dalam bahasa Inggris di semua bahasa;
# deskripsinya diterjemahkan.

## Pembacaan

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (0 sampai 99)
tip-wings-level = sayap mendatar
tip-bank-right = bank { $deg }° ke kanan
tip-bank-left = bank { $deg }° ke kiri
tip-attitude-readout = Pitch { $pitch }°, { $bank }
tip-heading = Haluan { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° pada { $distance }
tip-nozzle-open = terbuka { $value } %
tip-nozzles = Nozzle { $deg }°
tip-key = Tombol: { $key }
tip-keys = Tombol: { $keys }

