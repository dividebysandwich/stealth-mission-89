# Cuaca pada briefing dan layar Ops kampanye. Nama awan memakai nama internasional.

wx-cumulus = cumulus
wx-cumulonimbus = cumulonimbus
wx-altostratus = altostratus
wx-stratus = stratus
wx-stratocumulus = stratocumulus
wx-clear = Cuaca: cerah, jarak pandang { $vis } km.
wx-layer = { $name } { $cover }% mulai { $base } ft
wx-layer-top = { $name } { $cover }% { $base }-{ $top } ft
wx-line = Cuaca: { $sky } - { $layers }, jarak pandang { $vis } km.
wx-sky-clear = cerah
wx-sky-scattered = awan tersebar
wx-sky-broken = awan pecah
wx-sky-overcast = mendung
wx-sky-storm = badai petir
