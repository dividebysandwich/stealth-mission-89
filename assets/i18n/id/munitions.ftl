# Amunisi: stok pangkalan udara, pangkalan produksi, penerbangan kargo.

mu-sam-long = SAM jarak jauh
mu-sam-medium = SAM jarak menengah
mu-sam-short = SAM jarak pendek
cl-production-moved = { $base } menjadi pangkalan produksi baru
