axis-look-y = Lihat atas / bawah
axis-view-zoom = Zoom tampilan perbesar / perkecil
input-button = Tombol { $n }
input-axis = Sumbu { $n }
vr-trigger = Pelatuk
vr-stick-click = Klik stick
vr-stick-up = Stick ke atas
vr-stick-down = Stick ke bawah
vr-stick-left = Stick ke kiri
vr-stick-right = Stick ke kanan
vr-grip = Grip

input-title = PEMETAAN INPUT
input-clear-all = HAPUS SEMUA
    .facts = Menghapus semua penetapan sumbu dan tombol joystick (tombol keyboard tetap)
input-clear-all-done = Semua pengaturan joystick dihapus
input-default-keys = TOMBOL BAWAAN
    .facts = Memulihkan tombol bawaan papan ketik
input-default-keys-done = Tombol bawaan dipulihkan
input-default-joystick = JOYSTICK BAWAAN
    .facts = Menghapus pengaturan joystick Anda dan kembali memakai tata letak bawaan joystick dan gamepad yang dikenal
input-default-joystick-done = Pengaturan joystick dikembalikan ke tata letak bawaan
input-no-joysticks = TIDAK ADA JOYSTICK TERDETEKSI  (sambungkan perangkat; akan muncul di sini)
input-gamepad = Tata letak gamepad standar
    .facts = Stick kiri, stick kanan kemudi, pemicu throttle, tombol depan tembak / meriam / senjata / bay. Back / Select roda pendarat, klik stik flare / chaff, D-pad target. Tombol atau sumbu yang ditetapkan di sini hanya melakukan apa yang ditetapkan padanya. Matikan jika tombol joystick melakukan hal yang tidak ditetapkan padanya.
input-device-defaults = Tata letak bawaan untuk joystick yang dikenal
    .facts = Stick, throttle, dan pedal yang dikenal (Thrustmaster, Logitech/Saitek, VKB, Virpil, CH, Honeycomb, MOZA) sudah memiliki sumbu dan tombol yang terpasang. Kontrol yang Anda pasang atau hapus sendiri menggantikan tata letak.
input-ffb = Force feedback
    .facts = Kekuatan gaya pada stik di base force feedback (MOZA AB6, AB9): pemusatan yang makin kaku seiring kecepatan, getaran menjelang stall, gemuruh landasan, pendaratan, dan kanon. 0% mematikannya. Atur pegas dan peredaman bawaan base rendah di MOZA Cockpit.
input-builtin = Tata letak bawaan perangkat ini: pasang atau hapus untuk mengubahnya
input-help = Klik BIND, lalu gerakkan sumbu atau tekan tombol; + menambah tombol. Esc membatalkan.
input-undo = URUNGKAN
    .facts = Mengembalikan pengaturan seperti sebelumnya
input-was = (sebelumnya: { $what })
input-preview-help = Pesawat di kanan menunjukkan fungsi sumbu yang dipetakan: balikkan sumbu jika bergerak ke arah yang salah.
input-no-match = TIDAK ADA YANG COCOK
input-axes = SUMBU
input-invert = Balikkan
input-dead-zone = zona mati
input-curve = Kurva
input-expo = Kurva respons
    .facts = 0%: lurus. Lebih: lebih halus di tengah, sama cepat di ujung
input-saturation = Saturasi
    .facts = Jarak gerak untuk nilai penuh: di bawah 100% sumbu mencapai ujung lebih awal
input-curve-straight = LURUS
input-move-it = gerakkan
input-axis-or-button = GERAKKAN SUATU SUMBU, ATAU TEKAN TOMBOL UNTUK { $action }...
input-button-for = SEKARANG TEKAN TOMBOL UNTUK { $action }...
input-noisy-axis = { $axis } diabaikan: bergetar sendiri
input-buttons = TOMBOL
input-keyboard = PAPAN KETIK
input-joystick = JOYSTICK
input-press-key = TEKAN SUATU TOMBOL...
input-mouse-left = Tombol kiri mouse
input-mouse-right = Tombol kanan mouse
input-mouse-middle = Tombol tengah mouse
input-mouse-back = Tombol mundur mouse
input-mouse-forward = Tombol maju mouse
input-mouse-other = Tombol mouse { $n }
input-press-key-or-mouse = TEKAN TOMBOL, ATAU TOMBOL MOUSE DI MENUNGGU...
input-keyboard-mouse = KEYBOARD / MOUSE
input-waiting = MENUNGGU
input-add-key = Tambah tombol (diambil dari aksi lain mana pun)
input-press-button = TEKAN SUATU TOMBOL...
input-save-failed = tidak dapat menyimpan pemetaan input: { $error }
input-clear-search = Hapus pencarian
input-defaults = BAWAAN
input-vr-trigger-note = Pelatuk hanya berfungsi selama tangannya memegang throttle (kiri) atau stick (kanan); jika tidak, pelatuk menekan kontrol di bawah ujung jari.
input-vr-grab = Pegang dengan
input-vr-grab-toggle = Pegang alih
input-vr-grab-bound = Pegang
input-vr-grab-note = Pegang mengambil tongkat, throttle, gagang lontar, dan kneeboard. Dengan pegang alih, tekan sekali untuk memegang dan sekali lagi untuk melepas.
input-left-hand = TANGAN KIRI
input-right-hand = TANGAN KANAN
input-bind = TETAPKAN
input-centre = TENGAH
