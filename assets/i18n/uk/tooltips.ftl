# Підказки кабіни (src/cockpit3d/tooltips.rs). Заголовок, що є написом кабіни (лампа, кнопка,
# абревіатура), лишається англійською; описи перекладено.

## Покази приладів

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (від 0 до 99)
tip-wings-level = крила в горизонті
tip-bank-right = крен { $deg }° праворуч
tip-bank-left = крен { $deg }° ліворуч
tip-attitude-readout = Тангаж { $pitch }°, { $bank }
tip-heading = Курс { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }°, відстань { $distance }
tip-nozzle-open = відкрито на { $value } %
tip-key = Клавіша: { $key }
tip-keys = Клавіші: { $keys }

