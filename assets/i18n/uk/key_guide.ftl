# Довідник клавіш (src/key_guide.rs). У назвах клавіш "_" замінює пробіл.

kg-vr-controllers = VR-КОНТРОЛЕРИ
kg-vr-grip = GRIP
    .desc = Схопити ручку, РУД або планшет на коліно
kg-vr-fingertip = КІНЧИК_ПАЛЬЦЯ
    .desc = Натискати перемикачі та кнопки, вкладки планшета
