# Die Cockpit-Tooltips (src/cockpit3d/tooltips.rs). Ein Titel, der die Beschriftung des
# Cockpits ist (Lampe, Randtaste oder Konsolenknopf, Abkürzung), bleibt in jeder Sprache
# englisch; die Beschreibungen werden übersetzt.

## Anzeigewerte

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (0 bis 99)
tip-wings-level = Flügel waagerecht
tip-bank-right = Querneigung { $deg }° rechts
tip-bank-left = Querneigung { $deg }° links
tip-attitude-readout = Nicklage { $pitch }°, { $bank }
tip-heading = Kurs { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° in { $distance }
tip-nozzle-open = { $value } % offen
tip-nozzles = Düsen { $deg }°
tip-key = Taste: { $key }
tip-keys = Tasten: { $keys }

## Aktionen: der Name, dann was sie bewirkt

tip-gear = Fahrwerk
