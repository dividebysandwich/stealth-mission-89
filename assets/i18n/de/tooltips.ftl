tip-flir = FLIR
    .desc = Infrarotbild an / aus
tip-ils = ILS
    .desc = Instrumentenlandesystem: Landeführung und die Steuerbalken im HUD
tip-mission-orders = Missionsbefehle
tip-cam-ahead = Verfolgerkamera
    .desc = Blickt nach vorn
tip-cam-rear = Verfolgerkamera
    .desc = Blickt nach hinten
tip-cam-right = Verfolgerkamera
    .desc = Blickt nach rechts
tip-cam-left = Verfolgerkamera
    .desc = Blickt nach links
tip-designate-target = Ziel markieren
    .desc = Blinkt, solange ein Ziel markiert ist, leuchtet stetig in Waffenreichweite
tip-select-target = Nächstes Ziel
    .desc = Das nächste Ziel wählen
tip-nearest-target = Nächstgelegenes Ziel
    .desc = Das nächstgelegene Ziel voraus aufschalten
tip-clear-target = Ziel lösen
