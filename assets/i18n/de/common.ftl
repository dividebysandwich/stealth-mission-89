# Stealth Mission 89: Wörter aller Bildschirme (siehe en/common.ftl und ../README.md).

language = Sprache
    .facts =
        Die Sprache der Menüs, Tooltips, Briefings und Meldungen
        Die Beschriftungen des Cockpits (HUD, MFD, Panel) bleiben englisch, wie im echten Flugzeug

## Schaltflächen

back = ZURÜCK
    .facts = Zurück zum vorherigen Bildschirm
ok = OK
cancel = ABBRECHEN
close = SCHLIESSEN
continue = WEITER
yes = JA
no = NEIN
on = AN
off = AUS
classic = KLASSISCH
modern = MODERN

## Tests des Übersetzungssystems

i18n-test-count = { $n ->
    [one] { $n } Treffer
   *[other] { $n } Treffer
}
i18n-test-lines =
    Erste Zeile
    Zweite Zeile
i18n-test-nested = Wählen: { $what }
