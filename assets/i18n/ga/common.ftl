# Stealth Mission 89: focail choitianta do gach scáileán (féach en/common.ftl agus glossary.md).
#
# Is é an Béarla foinse gach aistriúcháin. Taispeántar teachtaireacht atá ar iarraidh i dteanga
# i mBéarla. Fanann i mBéarla i ngach áit: an méid a thaispeánann an cockpit (lipéid HUD, MFD
# agus painéil), acrainmneacha (FLIR, ILS, CCIP, SAM, RWR...), ainmneacha aerárthach, arm agus áiteanna.
#
# Comhréir Fluent: ní féidir le líne de théacs il-líne tosú le "[", "*" ná ".".

language = Teanga
    .facts =
        Teanga na roghchlár, na leideanna uirlise, na mbriefing agus na dteachtaireachtaí
        Fanann lipéid an chockpit féin (HUD, MFD, painéal) i mBéarla, mar atá san aerárthach fíor

## Cnaipí

back = AR AIS
    .facts = Ar ais chuig an scáileán roimhe seo
ok = OK
cancel = CEANCAIL
close = DÚN
continue = LEANÚINT
yes = IS EA
no = NÍL
on = ON
off = OFF
