modern = NUA-AIMSEARTHA

## Tástálacha ar chóras an aistrithe

i18n-test-count = { $n ->
    [one] { $n } bhuille
    [two] { $n } bhuille
    [few] { $n } buille
    [many] { $n } mbuille
   *[other] { $n } buille
}
i18n-test-lines =
    An chéad líne
    An dara líne
i18n-test-nested = Roghnaigh: { $what }
