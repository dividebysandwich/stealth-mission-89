## Roghanna an mhisin

menu-start-random = Randamach
    .facts =
        Roghnaithe le gach misean nua, mar atá sa mhodh clasaiceach
        06:00-08:00 sa lá nó 18:00-20:00 san oíche
        Díthiceáil chun an uair a roghnú
menu-start-slider =
    .facts =
        Am an éirí den talamh
        Oíche ó 18:00 go 06:00
        Coinnithe ag MISEAN NUA
menu-realistic-weapons = Airm réadúla
    .facts =
        Teorainneacha an aerárthaigh fhíor
        2 chlós arm in ionad 4
        Gan diúracáin AIM-9 ná AIM-120
        Gan éirí den talamh ná tuirlingt ar iompróirí aerárthaigh
menu-crash-protection = Cosaint in aghaidh tuairteanna
    .facts =
        Tarraingíonn suas go huathoibríoch gar don talamh (gear suas)
        Ní bhíonn teagmháil leis an talamh ná imbhuailtí marfach
        As: is féidir an talamh a bhualadh i gcónaí
menu-tacview-export = Easpórtáil
    .facts =
        Sábhálann gach eitilt mar thaifead Tacview (.acmi)
        I bhfillteán an chluiche do do chomhaid, faoi tacview
menu-tacview-real-time = Telemetry fíor-ama
    .facts =
        Seolann an eitilt chuig Tacview agus tú ag eitilt
        In Tacview: Record > Real-Time Telemetry
        Seoladh 127.0.0.1, port 42674 (--tacview-address)
switch-game = CLUICHE
switch-real = FÍOR
menu-damage = Damáiste
    .facts =
        Damáiste na n-arm
        Cluiche: damáiste clasaiceach; cuireann buillí le chéile ach ní leagann siad an t-aerárthach choíche
        Réadúil: is féidir le buille diúracáin an t-aerárthach a scriosadh (díbir!), déanann sé damáiste do níos mó córas agus cuireann sé tine ar siúl go minic, a mhúchann nó a phléascann an t-aerárthach
        Réadúil: cuireann dromchlaí rialaithe damáistithe an t-aerárthach as trim nó cuireann siad ag corraí é
menu-guidance = Treoir
    .facts =
        Treoir diúracán
        Clasaiceach: diúracáin ag eitilt díreach chuig a sprioc
        Réadúil: loingseoireacht chomhréireach go pointe an imbhuailte; múchann na móitéir agus téann na diúracáin ar scáth ag caillteanas luais le gach casadh (deatach nuair a bhíonn an móitéar ar lasadh amháin)
        Réadúil: tógann SAManna airde in aghaidh spriocanna i bhfad uathu; eitlíonn an AIM-120 díreach ar feadh 3 s (tarraing suas chun é a lobáil)
menu-air-defence = Aerchosaint
    .facts =
        Aerchosaint ísealairde
        Clasaiceach: láithreacha SAM agus trodaire-aerárthaigh amháin
        Réadúil: gunnaí ZSU-23-4 treoraithe le radar (feiceann a radar thú mar a dhéanann radar SAM) agus ceallraí flak S-60 ag cosaint aerfort agus spriocanna; foirne MANPADS sna bailte ag lámhach SA-14 ar a bhfeiceann siad
        Éiríonn sé contúirteach eitilt íseal os cionn áiteanna cosanta; scriosann buamaí agus gunna na gunnaí

