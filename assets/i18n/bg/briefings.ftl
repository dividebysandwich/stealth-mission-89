bt-destroy-at-1 = Неутрализирайте { $what } при { $place }
bt-destroy-at-2 = Нанесете удар по { $what } при { $place }
bt-destroy-0 = Унищожете { $what }
bt-destroy-1 = Неутрализирайте { $what }
bt-destroy-2 = Нанесете удар по { $what }
bt-suffix-deadline-0 = {" "}не по-късно от { $deadline }.
bt-suffix-deadline-1 = {" "}до { $deadline }.
bt-suffix-deadline-2 = {" "}преди { $deadline }.
