# Stealth Mission 89: думи, общи за всички екрани.
#
# Английският е източникът на всеки превод. Съобщение, което липсва в даден език, се показва на
# английски. На английски остава навсякъде: каквото показва кабината (HUD, MFD и надписите на
# панела), съкращенията (FLIR, ILS, CCIP, SAM, RWR...), имената на самолети, оръжия и места
# (fichiers_md/translation.md и glossary.md в папката на всеки език).
#
# Синтаксис на Fluent: ред от многоредов текст не трябва да започва с "[", "*" или "."; фигурните
# скоби се пишат {"{"} и {"}"}.

language = Език
    .facts =
        Езикът на менютата, подсказките, брифингите и съобщенията
        Надписите на самата кабина (HUD, MFD, панел) остават на английски, както в истинския самолет

## Бутони

back = НАЗАД
    .facts = Назад към предишния екран
ok = OK
cancel = ОТКАЗ
close = ЗАТВАРЯНЕ
continue = ПРОДЪЛЖАВАНЕ
yes = ДА
no = НЕ
on = ВКЛ.
off = ИЗКЛ.
classic = КЛАСИЧЕСКИ
modern = СЪВРЕМЕНЕН

## Проби на системата за превод

i18n-test-count = { $n ->
    [one] { $n } попадение
   *[other] { $n } попадения
}
i18n-test-lines =
    Първи ред
    Втори ред
i18n-test-nested = Изберете: { $what }
