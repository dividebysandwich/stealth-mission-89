# Подсказките на кабината (src/cockpit3d/tooltips.rs). Заглавие, което е собственият надпис на
# кабината (лампа, бутон по рамката или конзолата, съкращение), остава на английски във всеки
# език; описанията са преведени.

## Показания

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (от 0 до 99)
tip-wings-level = крила хоризонтално
tip-bank-right = крен { $deg }° надясно
tip-bank-left = крен { $deg }° наляво
tip-attitude-readout = Тангаж { $pitch }°, { $bank }
tip-heading = Курс { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° на { $distance }
tip-nozzle-open = отворена на { $value } %
tip-key = Клавиш: { $key }
tip-keys = Клавиши: { $keys }

## Действия: името, после какво прави

tip-gear = Колесник
    .desc = Колесникът прибран / изпънат (лостът показва положението)
tip-autopilot = Автопилот
    .desc = Лети към текущия waypoint (Tornado: следвайки терена)
tip-bay-doors = Люкове на оръжейните отсеци
    .desc = Отваряне / затваряне; оръжията се пускат само при отворени отсеци
tip-flaps = Закрилки
    .desc = Повече подемна сила, скоростта на сваляне е около 20 % по-ниска
tip-brakes = Спирачки
    .desc = Колесни спирачки на земята, въздушна спирачка във въздуха
tip-eject = Ръкохватка за катапултиране
    .desc = Катапултиране
tip-master-caution = Master caution
    .desc = Заглушава алармите: пожар, сваляне и радарни предупреждения
tip-hud-mode = Режим на HUD
    .desc = NAV, AIR, GND
tip-bomb-mode = Режим на бомбардиране
    .desc = CCIP / CCRP
tip-hud-declutter = Облекчаване на HUD
tip-maps = Страница на левия MFD
    .desc = Карта / тактика
tip-nvg = Очила за нощно виждане
tip-ordnance = Страница на оръжията
    .desc = Десен MFD
tip-flir = FLIR
    .desc = Инфрачервена картина вкл. / изкл.
tip-ils = ILS
    .desc = Система за кацане по прибори: насочване при кацане и стрелките за управление на HUD
tip-mission-orders = Заповеди за мисията
tip-cam-ahead = Следяща камера
    .desc = Гледа напред
tip-cam-rear = Следяща камера
    .desc = Гледа назад
tip-cam-right = Следяща камера
    .desc = Гледа надясно
tip-cam-left = Следяща камера
    .desc = Гледа наляво
tip-designate-target = Означаване на цел
    .desc = Мига, докато има означена цел, свети постоянно в обсега на оръжието
tip-select-target = Следваща цел
    .desc = Избира следващата цел
tip-nearest-target = Най-близка цел
    .desc = Захваща най-близката цел отпред
tip-clear-target = Освобождаване на целта
    .desc = Няма автоматичен захват до следващия клавиш за цел
tip-select-weapon = Избор на оръжие
    .desc = Следващото оръжие, след последното оръдието
tip-fire-weapon = Стрелба
    .desc = Пуска избраното оръжие
tip-flare = Топлинен капан
    .desc = Пуска топлинен капан (срещу инфрачервени ракети)
tip-chaff = Chaff
    .desc = Пуска chaff, диполни отражатели (срещу радарни ракети)
tip-decoy = Примамка
    .desc = Пуска примамка
tip-ecm = ECM
    .desc = Радарен заглушител вкл. / изкл. (свети, когато е включен)
tip-ir-jammer = IR заглушител
