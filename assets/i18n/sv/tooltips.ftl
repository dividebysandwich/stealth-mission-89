# Cockpitens tooltips (src/cockpit3d/tooltips.rs). En rubrik som är cockpitens egen beteckning
# (lampa, ram- eller konsolknapp, förkortning) förblir på engelska; beskrivningarna översätts.

## Avläsningar

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (0 till 99)
tip-wings-level = vingar i våg
tip-bank-right = { $deg }° lutning åt höger
tip-bank-left = { $deg }° lutning åt vänster
tip-attitude-readout = Stigning { $pitch }°, { $bank }
tip-heading = Kurs { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° på { $distance }
tip-nozzle-open = { $value } % öppen
tip-key = Tangent: { $key }
tip-keys = Tangenter: { $keys }

