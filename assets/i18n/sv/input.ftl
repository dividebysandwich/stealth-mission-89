input-title = KNAPPKARTLÄGGNING
input-clear-all = RENSA ALLT
    .facts = Tar bort alla tilldelningar av joystickens axlar och knappar (tangenterna finns kvar)
input-clear-all-done = Alla joystickbindningar borttagna
input-default-keys = STANDARDTANGENTER
    .facts = Återställer tangentbordets standardtangenter
input-default-keys-done = Standardtangenter återställda
input-default-joystick = STANDARDJOYSTICK
    .facts = Tar bort dina joystickbindningar och använder åter de inbyggda layouterna för kända joysticks och handkontroller
input-default-joystick-done = Joystickbindningar återställda till de inbyggda layouterna
input-no-joysticks = INGA JOYSTICKS HITTADES  (anslut en enhet, så visas den här)
input-gamepad = Standardlayout för handkontroll
    .facts = Vänster stick, höger stick roder, avtryckare gas, frontknappar eld / kanon / vapen / lastrum. Back / Select landställ, spakklick facklor / remsor, styrkors mål. En knapp eller axel som tilldelats här gör bara det den tilldelats. Stäng av om en joystick knappar gör saker de inte tilldelats.
input-device-defaults = Inbyggda layouter för kända styrspakar
    .facts = Kända spakar, gasreglage och pedaler (Thrustmaster, Logitech/Saitek, VKB, Virpil, CH, Honeycomb, MOZA) får sina axlar och knappar tilldelade. En kontroll du själv tilldelar eller rensar går före layouten.
input-ffb = Force feedback
    .facts = Styrkan på krafterna i spaken på en force feedback-bas (MOZA AB6, AB9): centrering som blir styvare med farten, skakningar före överstegring, mullret på banan, sättningar och kanonen. 0 % stänger av. Ställ basens egen fjäder och dämpning lågt i MOZA Cockpit.
input-builtin = Enhetens inbyggda layout: tilldela eller rensa för att ändra den
input-help = Klicka på BIND och flytta sedan en axel eller tryck på en knapp; + lägger till en tangent. Esc avbryter.
input-undo = ÅNGRA
    .facts = Återställer bindningarna som de var innan
input-was = (var: { $what })
input-preview-help = Flygplanet till höger visar vad de kopplade axlarna gör: invertera en axel om den rör sig åt fel håll.
input-no-match = INGEN TRÄFF
input-axes = AXLAR
input-invert = Invertera
input-dead-zone = dödzon
input-curve = Kurva
input-expo = Responskurva
    .facts = 0 %: rak. Mer: finare kring mitten, lika snabb i ändarna
input-saturation = Mättnad
    .facts = Rörelsen som ger fullt värde: under 100 % når axeln slutet tidigare
input-curve-straight = RAK
input-move-it = flytta den
input-move-axis = FLYTTA EN AXEL...
input-noisy-axis = { $axis } ignoreras: den darrar av sig själv
input-buttons = KNAPPAR
input-keyboard = TANGENTBORD
input-joystick = JOYSTICK
input-press-key = TRYCK PÅ EN TANGENT...
