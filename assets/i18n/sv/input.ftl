input-press-button = TRYCK PÅ EN KNAPP...
input-save-failed = kunde inte spara knappkartläggningen: { $error }
input-clear-search = Rensa sökningen
input-defaults = STANDARD
input-vr-trigger-note = En avtryckare räknas bara när den handen håller gasreglaget (vänster) eller spaken (höger); annars trycker den på reglaget under fingertoppen.
input-vr-grab = Grip med
