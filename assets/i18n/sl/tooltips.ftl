# Tooltipi kabine (src/cockpit3d/tooltips.rs). Naslov, ki je oznaka same kabine (lučka, gumb
# na okvirju ali konzoli, kratica), ostane v angleščini; opisi so prevedeni.

## Odčitki

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (od 0 do 99)
tip-wings-level = krila v vodoravni legi
tip-bank-right = nagib { $deg }° desno
tip-bank-left = nagib { $deg }° levo
tip-attitude-readout = Nagib nosu { $pitch }°, { $bank }
tip-heading = Smer { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° na { $distance }
tip-nozzle-open = odprta { $value } %
tip-key = Tipka: { $key }
tip-keys = Tipke: { $keys }

