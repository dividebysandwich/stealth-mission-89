ok = OK
cancel = ОТМЕНА
close = ЗАКРЫТЬ
continue = ПРОДОЛЖИТЬ
yes = ДА
no = НЕТ
on = ВКЛ
off = ВЫКЛ
classic = КЛАССИЧЕСКИЙ
modern = СОВРЕМЕННЫЙ

## Проверка системы перевода

i18n-test-count = { $n ->
    [one] { $n } попадание
    [few] { $n } попадания
    [many] { $n } попаданий
   *[other] { $n } попадания
}
i18n-test-lines =
    Первая строка
    Вторая строка
i18n-test-nested = Выбрать: { $what }
