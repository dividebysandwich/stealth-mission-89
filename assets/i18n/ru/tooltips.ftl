# Подсказки кабины (src/cockpit3d/tooltips.rs). Заголовок, который является надписью кабины
# (лампа, кнопка у дисплея или на пульте, аббревиатура), остаётся на английском во всех языках;
# описания переводятся.

## Показания приборов

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (от 0 до 99)
tip-wings-level = без крена
tip-bank-right = крен { $deg }° вправо
tip-bank-left = крен { $deg }° влево
tip-attitude-readout = Тангаж { $pitch }°, { $bank }
tip-heading = Курс { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: пеленг { $bearing }°, { $distance }
tip-nozzle-open = открыто на { $value }%
tip-key = Клавиша: { $key }
tip-keys = Клавиши: { $keys }

## Действия: название, затем что оно делает

tip-gear = Шасси
    .desc = Убрать / выпустить шасси (рычаг показывает положение)
tip-autopilot = Автопилот
    .desc = Ведёт самолёт на текущий ППМ (Tornado: с огибанием рельефа)
tip-bay-doors = Створки бомбоотсеков
    .desc = Открыть / закрыть; оружие сбрасывается только при открытых отсеках
tip-flaps = Закрылки
    .desc = Больше подъёмной силы, скорость сваливания ниже примерно на 20 %
tip-brakes = Тормоза
    .desc = Тормоза колёс на земле, воздушный тормоз в воздухе
tip-eject = Ручка катапультирования
    .desc = Катапультироваться
tip-master-caution = Master caution
    .desc = Отключает сигнализацию: пожар, сваливание и предупреждения о радарах
tip-hud-mode = Режим HUD
    .desc = NAV, AIR, GND
tip-bomb-mode = Режим бомбометания
    .desc = CCIP / CCRP
tip-hud-declutter = Разгрузка HUD
tip-maps = Страница левого MFD
    .desc = Карта / тактика
tip-nvg = Очки ночного видения
tip-ordnance = Страница оружия
    .desc = Правый MFD
tip-flir = FLIR
    .desc = Инфракрасное изображение вкл. / выкл.
tip-ils = ILS
    .desc = Инструментальная система посадки: наведение на посадку и директорные планки HUD
tip-mission-orders = Боевой приказ
tip-cam-ahead = Следящая камера
    .desc = Смотрит вперёд
tip-cam-rear = Следящая камера
    .desc = Смотрит назад
tip-cam-right = Следящая камера
    .desc = Смотрит вправо
tip-cam-left = Следящая камера
    .desc = Смотрит влево
tip-designate-target = Назначить цель
    .desc = Мигает, пока цель назначена, горит постоянно в зоне досягаемости оружия
tip-select-target = Следующая цель
    .desc = Выбрать следующую цель
tip-nearest-target = Ближайшая цель
    .desc = Захватить ближайшую цель впереди
tip-clear-target = Сбросить цель
    .desc = Без автоматического захвата до следующего нажатия клавиши цели
tip-select-weapon = Выбор оружия
    .desc = Следующее оружие, после последнего пушка
tip-fire-weapon = Пуск
    .desc = Применить выбранное оружие
tip-flare = Тепловая ловушка
    .desc = Отстрелить тепловую ловушку (против ИК-ракет)
tip-chaff = Chaff
    .desc = Отстрелить дипольные отражатели (против радиолокационных ракет)
tip-decoy = Ложная цель
    .desc = Выпустить ложную цель
tip-ecm = ECM
    .desc = Радиопомеха вкл. / выкл. (горит, когда включена)
tip-ir-jammer = ИК-помеха
    .desc = Вкл. / выкл.; сама отключается через 20 с и должна остыть
tip-select-waypoint = ППМ
    .desc = Страница ППМ
tip-change-waypoint = Сменить ППМ
tip-reset-waypoint = Сбросить ППМ
tip-last-waypoint = Предыдущий ППМ
tip-next-waypoint = Следующий ППМ
tip-menu = Меню настроек
    .desc = Открывает или закрывает меню полёта
tip-volume = Громкость звука
tip-detail = Уровень детализации
tip-time-accel = Ускорение времени
    .desc = Прекращается, когда радар обнаруживает самолёт или применяется оружие
tip-time-normal = Обычное время
tip-map-zoom-in = Увеличить масштаб карты
tip-map-zoom-out = Уменьшить масштаб карты
tip-map-orientation = Ориентация карты
    .desc = Север вверху / курс вверху
tip-lock-cursor = Захват под курсором
    .desc = Захватить то, что находится под курсором датчика
tip-swap-soi = Активный датчик (SOI)
    .desc = Переходит на другой MFD
tip-kneeboard = Наколенный планшет
    .desc = Показать поверх вида, следующая страница, скрыть
tip-chat = Чат
    .desc = Написать сообщение другим игрокам
tip-camera-zoom-in = Приблизить камеру
tip-camera-zoom-out = Отдалить камеру

