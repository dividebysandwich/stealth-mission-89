# Погода в брифингах и на экране операций кампании. Облака названы по международной
# классификации (в русских названиях).

wx-cumulus = кучевые
wx-cumulonimbus = кучево-дождевые
wx-altostratus = высокослоистые
wx-stratus = слоистые
wx-stratocumulus = слоисто-кучевые
wx-clear = Погода: ясно, видимость { $vis } км.
wx-layer = { $name } { $cover }% от { $base } ft
wx-layer-top = { $name } { $cover }% { $base }-{ $top } ft
wx-line = Погода: { $sky } - { $layers }, видимость { $vis } км.
wx-sky-clear = ясно
wx-sky-scattered = рассеянная облачность
wx-sky-broken = значительная облачность
wx-sky-overcast = сплошная облачность
wx-sky-storm = грозы
