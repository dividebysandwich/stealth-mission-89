tip-autopilot = Autopilot
    .desc = Prowadzi do bieżącego waypointu (Tornado: z podążaniem za terenem)
tip-bay-doors = Drzwi komór uzbrojenia
    .desc = Otworzyć / zamknąć; uzbrojenie można zrzucić tylko przy otwartych komorach
tip-flaps = Klapy
    .desc = Większa siła nośna, prędkość przeciągnięcia niższa o około 20%
tip-brakes = Hamulce
    .desc = Hamulce kół na ziemi, hamulec aerodynamiczny w powietrzu
tip-eject = Uchwyt katapulty
    .desc = Katapultować się
tip-master-caution = Master caution
    .desc = Wycisza alarmy: pożar, przeciągnięcie i ostrzeżenia radarowe
tip-hud-mode = Tryb HUD
    .desc = NAV, AIR, GND
tip-bomb-mode = Tryb bombardowania
    .desc = CCIP / CCRP
tip-hud-declutter = Uproszczenie HUD
tip-maps = Strona lewego MFD
    .desc = Mapa / taktyczny
tip-nvg = Gogle noktowizyjne
tip-ordnance = Strona uzbrojenia
    .desc = Prawy MFD
tip-flir = FLIR
    .desc = Obraz w podczerwieni wł. / wył.
tip-ils = ILS
