tip-cam-rear = Kamera śledząca
    .desc = Patrzy do tyłu
tip-cam-right = Kamera śledząca
    .desc = Patrzy w prawo
tip-cam-left = Kamera śledząca
    .desc = Patrzy w lewo
tip-designate-target = Wskazać cel
    .desc = Miga, gdy cel jest wskazany, świeci stale w zasięgu broni
tip-select-target = Następny cel
    .desc = Wybrać następny cel
tip-nearest-target = Najbliższy cel
    .desc = Namierzyć najbliższy cel z przodu
tip-clear-target = Skasować cel
