# Tooltipy kokpitu (src/cockpit3d/tooltips.rs). Tytuł będący napisem w kokpicie (lampka,
# przycisk, skrót) pozostaje po angielsku; opisy są przetłumaczone.

## Odczyty przyrządów

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (od 0 do 99)
tip-wings-level = skrzydła poziomo
tip-bank-right = przechylenie { $deg }° w prawo
tip-bank-left = przechylenie { $deg }° w lewo
tip-attitude-readout = Pochylenie { $pitch }°, { $bank }
tip-heading = Kurs { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° w odległości { $distance }
tip-nozzle-open = otwarta w { $value }%
tip-key = Klawisz: { $key }
tip-keys = Klawisze: { $keys }

## Akcje: nazwa, potem działanie

tip-gear = Podwozie
