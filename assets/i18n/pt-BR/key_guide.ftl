# O guia de teclas (src/key_guide.rs): a página KEYS da prancheta de perna e o GUIA DE TECLAS
# do menu em voo, desenhados com a fonte vetorial; os títulos das seções também encabeçam as
# listas do diálogo CONTROLES.
# Nos textos das teclas, "_" substitui um espaço (as palavras ficam na mesma linha).

kg-vr-controllers = CONTROLES VR
kg-vr-grip = GRIP
    .desc = Segurar o manche, o manete ou a prancheta de perna
kg-vr-fingertip = PONTA_DO_DEDO
    .desc = Apertar interruptores e botões, abas da prancheta de perna
kg-vr-left-stick = STICK_ESQUERDO
    .desc = Mover o cursor do sensor
kg-vr-stick = STICK
    .desc = Rolar esta lista (dedo na prancheta de perna)
kg-gun-target = Canhão
kg-mouse = MOUSE
kg-mouse-right-drag = ARRASTAR_DIREITO
    .desc = Olhar ao redor (fora: girar a câmera em órbita)
kg-mouse-hold-right = SEGURAR_DIREITO, RODA
    .desc = Aproximar / afastar a vista
kg-mouse-left-click = CLIQUE_ESQUERDO
    .desc = Apertar um interruptor ou botão do cockpit, uma aba da prancheta de perna
kg-mouse-point = APONTAR
    .desc = Tooltip de um comando do cockpit (menu: TOOLTIPS)
kg-mouse-wheel = RODA
    .desc = Rolar esta lista
kg-unbound = SEM_ATRIBUIÇÃO

