# As tooltips do cockpit (src/cockpit3d/tooltips.rs). Um título que é a inscrição do
# cockpit (luz, botão, sigla) fica em inglês; as descrições são traduzidas.

## Leituras dos instrumentos

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (de 0 a 99)
tip-wings-level = asas niveladas
tip-bank-right = inclinação { $deg }° à direita
tip-bank-left = inclinação { $deg }° à esquerda
tip-attitude-readout = Arfagem { $pitch }°, { $bank }
tip-heading = Proa { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° a { $distance }
tip-nozzle-open = { $value }% aberta
tip-key = Tecla: { $key }
tip-keys = Teclas: { $keys }

## Ações: o nome, depois o que ela faz

tip-gear = Trem de pouso
    .desc = Trem recolhido / baixado (a alavanca mostra a posição)
tip-autopilot = Piloto automático
    .desc = Voa até o waypoint atual (Tornado: seguindo o terreno)
tip-bay-doors = Portas dos compartimentos de armas
    .desc = Abrir / fechar; as armas só são lançadas com os compartimentos abertos
tip-flaps = Flaps
    .desc = Mais sustentação, velocidade de estol cerca de 20% menor
tip-brakes = Freios
    .desc = Freios das rodas no solo, speed brake em voo
tip-eject = Alça de ejeção
    .desc = Ejetar
tip-master-caution = Master caution
    .desc = Silencia os alarmes: incêndio, estol e alertas de radar
tip-hud-mode = Modo do HUD
    .desc = NAV, AIR, GND
tip-bomb-mode = Modo de bombardeio
    .desc = CCIP / CCRP
tip-hud-declutter = Declutter do HUD
tip-maps = Página do MFD esquerdo
    .desc = Mapa / tático
tip-nvg = Óculos de visão noturna
tip-ordnance = Página das armas
    .desc = MFD direito
tip-flir = FLIR
    .desc = Imagem infravermelha liga / desliga
tip-ils = ILS
    .desc = Sistema de pouso por instrumentos: guiagem de pouso e barras de comando do HUD
tip-mission-orders = Ordens da missão
tip-cam-ahead = Câmera de rastreamento
    .desc = Olhando à frente
tip-cam-rear = Câmera de rastreamento
    .desc = Olhando para trás
tip-cam-right = Câmera de rastreamento
    .desc = Olhando à direita
tip-cam-left = Câmera de rastreamento
    .desc = Olhando à esquerda
tip-designate-target = Designar alvo
    .desc = Pisca enquanto um alvo está designado, fixa dentro do alcance da arma
tip-select-target = Próximo alvo
    .desc = Selecionar o próximo alvo
tip-nearest-target = Alvo mais próximo
    .desc = Travar o alvo mais próximo à frente
tip-clear-target = Limpar alvo
    .desc = Sem aquisição automática até a próxima tecla de alvo
tip-select-weapon = Selecionar arma
    .desc = A próxima arma; depois da última, o canhão
tip-fire-weapon = Disparo
    .desc = Lançar ou disparar a arma selecionada
tip-flare = Flare
    .desc = Lançar um flare (contra mísseis infravermelhos)
tip-chaff = Chaff
    .desc = Lançar chaff (contra mísseis radar)
tip-decoy = Isca
    .desc = Lançar uma isca
tip-ecm = ECM
    .desc = Interferidor de radar liga / desliga (aceso quando ligado)
tip-ir-jammer = Interferidor IR
    .desc = Liga / desliga; desliga sozinho após 20 s e precisa esfriar
tip-select-waypoint = Waypoints
    .desc = Página dos waypoints
tip-change-waypoint = Trocar de waypoint
tip-reset-waypoint = Redefinir o waypoint
tip-last-waypoint = Waypoint anterior
tip-next-waypoint = Próximo waypoint
tip-menu = Menu de configurações
    .desc = Abre ou fecha o menu em voo
tip-volume = Volume do som
tip-detail = Nível de detalhe
tip-time-accel = Aceleração do tempo
    .desc = Termina quando um radar detecta a aeronave ou uma arma é lançada
tip-time-normal = Tempo normal
tip-map-zoom-in = Aproximar o mapa
tip-map-zoom-out = Afastar o mapa
tip-map-orientation = Orientação do mapa
    .desc = Norte para cima / proa para cima
tip-lock-cursor = Travar sob o cursor
    .desc = Travar o que está sob o cursor do sensor
tip-swap-soi = Sensor de interesse (SOI)
    .desc = Passa para o outro MFD
tip-kneeboard = Prancheta de perna
    .desc = Mostrá-la sobre a vista, próxima página, ocultá-la
tip-chat = Chat
    .desc = Escrever uma mensagem aos outros jogadores
tip-camera-zoom-in = Aproximar a câmera
tip-camera-zoom-out = Afastar a câmera

