# O tempo nos briefings e na tela de operações da campanha (crates/stealth-mission
# weather.rs). Os nomes das nuvens são os internacionais.

wx-cumulus = cumulus
wx-cumulonimbus = cumulonimbus
wx-altostratus = altostratus
wx-stratus = stratus
wx-stratocumulus = stratocumulus
wx-clear = Tempo: céu claro, visibilidade { $vis } km.
wx-layer = { $name } { $cover }% a partir de { $base } ft
wx-layer-top = { $name } { $cover }% { $base }-{ $top } ft
wx-line = Tempo: { $sky } - { $layers }, visibilidade { $vis } km.
wx-sky-clear = céu claro
wx-sky-scattered = nuvens esparsas
wx-sky-broken = céu nublado
wx-sky-overcast = encoberto
wx-sky-storm = trovoadas
