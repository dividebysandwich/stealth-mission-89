# Tooltipy kokpitu (src/cockpit3d/tooltips.rs). Názov, ktorý je označením samotného kokpitu
# (kontrolka, tlačidlo, skratka), zostáva po anglicky; popisy sú preložené.

## Údaje prístrojov

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (0 až 99)
tip-wings-level = krídla vodorovne
tip-bank-right = náklon { $deg }° vpravo
tip-bank-left = náklon { $deg }° vľavo
tip-attitude-readout = Sklon { $pitch }°, { $bank }
tip-heading = Kurz { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }° na { $distance }
tip-nozzle-open = otvorená na { $value } %
tip-nozzles = Dýzy { $deg }°
tip-key = Kláves: { $key }
tip-keys = Klávesy: { $keys }

