tip-cmd-ils = ILS オン / オフ
tip-cmd-hsd = Horizontal situation display（HSD）：真上から見た状況
tip-cmd-harm = HARM ターゲティング
tip-cmd-tgp = ターゲティングポッド（TGP）
tip-cmd-map = マップ
tip-cmd-sms = 兵装管理（SMS）
tip-cmd-hsi = Horizontal situation indicator（HSI）
