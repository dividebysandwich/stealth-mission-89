# コックピットのツールチップ（src/cockpit3d/tooltips.rs）。コックピット自体の表示
# （ランプ、ベゼルやコンソールのボタン、略語）であるタイトルはどの言語でも英語のままで、
# 説明文は翻訳されます。

## Readouts

tip-radar-bars-readout = EMV { $emv }、EGR { $egr }、EAR { $ear }（0～99）
tip-wings-level = 水平飛行
tip-bank-right = 右バンク { $deg }°
tip-bank-left = 左バンク { $deg }°
tip-attitude-readout = ピッチ { $pitch }°、{ $bank }
tip-heading = 方位 { $heading }°
tip-heading-waypoint = { $heading }、WP{ $wp }：{ $bearing }°、{ $distance }
tip-nozzle-open = 開度 { $value } %
tip-nozzles = ノズル { $deg }°
tip-key = キー：{ $key }
tip-keys = キー：{ $keys }

## Actions: the name, then what it does

tip-gear = 降着装置
    .desc = ギアアップ / ダウン（レバーが位置を示します）
tip-autopilot = オートパイロット
    .desc = 現在のウェイポイントへ飛行します（トーネード：地形追従）
tip-bay-doors = 兵装ベイ扉
    .desc = 開 / 閉。兵装はベイが開いているときだけ投下できます
tip-flaps = フラップ
    .desc = 揚力が増し、失速速度が約 20 % 下がります
tip-brakes = ブレーキ
    .desc = 地上ではホイールブレーキ、空中ではスピードブレーキ
tip-eject = 射出ハンドル
    .desc = 脱出
tip-master-caution = Master caution
    .desc = 新しい警告と注意で点灯。それらを確認し、警報を止めます
tip-hud-mode = HUDモード
    .desc = NAV、AIR、GND
tip-bomb-mode = 爆撃モード
    .desc = CCIP / CCRP
tip-hud-declutter = HUDデクラッター
tip-maps = 左 MFD ページ
    .desc = マップ / 戦術
tip-nvg = 暗視ゴーグル
tip-ordnance = 兵装ページ
    .desc = 右 MFD
tip-flir = FLIR
    .desc = 赤外線映像 オン / オフ
tip-ils = ILS
    .desc = 計器着陸装置：着陸誘導と HUD のステアリングバー
tip-mission-orders = ミッション命令
tip-cam-ahead = トラッキングカメラ
    .desc = 前方を向く
tip-cam-rear = トラッキングカメラ
    .desc = 後方を向く
tip-cam-right = トラッキングカメラ
    .desc = 右を向く
tip-cam-left = トラッキングカメラ
    .desc = 左を向く
tip-designate-target = 目標指定
    .desc = 目標を指定している間は点滅し、兵装の射程内では点灯します
tip-select-target = 次の目標
    .desc = 次の目標を選択します
tip-nearest-target = 最寄り目標
    .desc = 前方の最寄り目標をロックします
tip-clear-target = 目標解除
    .desc = 次の目標キーまで自動捕捉しません
tip-select-weapon = 兵装選択
    .desc = 次の兵装、最後の次は機関砲
tip-fire-weapon = 発射
    .desc = 選択した兵装を投下・発射します
tip-flare = フレア
    .desc = フレアを放出します（赤外線ミサイル対策）
tip-chaff = チャフ
    .desc = チャフを放出します（レーダーミサイル対策）
tip-decoy = デコイ
    .desc = デコイを放出します
tip-ecm = ECM
    .desc = レーダージャマー オン / オフ（オン時は点灯）
tip-ir-jammer = IRジャマー
    .desc = オン / オフ。20 秒後に自動で切れ、冷却が必要です
tip-select-waypoint = ウェイポイント
    .desc = ウェイポイントページ
tip-change-waypoint = ウェイポイント編集
    .desc = テンキーで選択中のウェイポイントを動かします
tip-reset-waypoint = ウェイポイントのリセット
    .desc = すべてのウェイポイントを計画位置に戻します
tip-last-waypoint = 前のウェイポイント
tip-next-waypoint = 次のウェイポイント
tip-menu = 設定メニュー
    .desc = 飛行中メニューを開く / 閉じる
tip-volume = 音量
tip-detail = ディテールレベル
tip-time-accel = 時間加速
    .desc = レーダーに探知されるか、兵装を投下すると解除されます
tip-time-normal = 通常時間
tip-map-zoom-in = マップ拡大
tip-map-zoom-out = マップ縮小
tip-map-orientation = マップの向き
    .desc = 北が上 / 進行方向が上
tip-lock-cursor = カーソル目標をロック
    .desc = センサーのカーソル下にあるものをロックします
tip-swap-soi = Sensor of interest
    .desc = もう一方の MFD に移ります
tip-kneeboard = ニーボード
    .desc = 視界に重ねて表示、次のページ、非表示
tip-chat = チャット
    .desc = 他のプレイヤーにメッセージを入力します
tip-camera-zoom-in = カメラ拡大
tip-camera-zoom-out = カメラ縮小

