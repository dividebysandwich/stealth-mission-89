# A pilótafülke tooltipjei (src/cockpit3d/tooltips.rs). Az a cím, amely a pilótafülke saját
# felirata (lámpa, gomb, rövidítés), minden nyelven angolul marad; a leírások le vannak
# fordítva.

## Kijelzett értékek

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (0-tól 99-ig)
tip-wings-level = szárnyak vízszintesen
tip-bank-right = { $deg }° bedöntés jobbra
tip-bank-left = { $deg }° bedöntés balra
tip-attitude-readout = Bólintás { $pitch }°, { $bank }
tip-heading = Irány { $heading }°
tip-heading-waypoint = { $heading }, WP{ $wp }: { $bearing }°, távolság { $distance }
tip-nozzle-open = { $value } %-ban nyitva
tip-key = Billentyű: { $key }
tip-keys = Billentyűk: { $keys }

