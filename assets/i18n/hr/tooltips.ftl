# Tooltipi kokpita (src/cockpit3d/tooltips.rs). Naslov koji je natpis samog kokpita
# (lampica, gumb, kratica) ostaje na engleskom; opisi su prevedeni.

## Očitanja instrumenata

tip-radar-bars-readout = EMV { $emv }, EGR { $egr }, EAR { $ear } (od 0 do 99)
tip-wings-level = krila u ravnini
tip-bank-right = nagib { $deg }° udesno
tip-bank-left = nagib { $deg }° ulijevo
tip-attitude-readout = Stav { $pitch }°, { $bank }
